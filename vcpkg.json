{
  "name": "gknextrenderer",
  "version": "1.0.0",
  "description": "Next generation renderer with Vulkan support",
  "homepage": "https://github.com/gameknife/gkNextRenderer",
  "dependencies": [
    {
      "name": "cpptrace",
      "platform": "!(android | ios)"
    },
    "cxxopts",
    {
      "name": "sdl3",
      "features": ["vulkan"],
      "platform": "!(android)"
    },
    {
      "name": "vulkan-headers",
      "platform": "!(android | ios)"
    },
    {
      "name": "dbus",
      "default-features": false,
      "platform": "linux"
    },
    "glm",
    {
      "name": "imgui",
      "features": [
        "freetype",
        "docking-experimental"
      ],
      "platform": "!(android)"
    },
    {
      "name": "imgui",
      "features": [
        "freetype",
        "docking-experimental"
      ],
      "platform": "android"
    },
    {
      "name": "rmlui",
      "features": ["freetype"]
    },
    "stb",
    "curl",
    "nlohmann-json",
    "tinygltf",
    "draco",
    "fmt",
    "meshoptimizer",
    "ktx",
    "joltphysics",
    "xxhash",
    "spdlog",
    {
      "name": "manifold",
      "platform": "!(android | ios)"
    },
    {
      "name": "earcut-hpp",
      "platform": "!(android | ios)"
    },
    {
      "name": "freetype",
      "platform": "!(android | ios)"
    },
    "cpp-base64",
    "catch2",
    "entt",
    "libwebp",
    {
      "name": "vulkan-loader",
      "platform": "linux",
      "features": [
        "xcb",
        "xlib",
        "wayland"
      ]
    },
    {
      "name": "vulkan-loader",
      "platform": "windows"
    },
    "vulkan-memory-allocator",
    {
      "name": "libdatachannel",
      "features": [
        "ws",
        "srtp"
      ],
      "platform": "!(android | ios | osx)"
    },
    {
      "name": "openh264",
      "platform": "!(android | ios | osx)"
    },
    {
      "name": "cpp-httplib",
      "platform": "!(android | ios | osx)"
    }
  ],
  "features": {
    "avif": {
      "description": "Enable AVIF image format support",
      "dependencies": [
        {
          "name": "libavif",
          "features": ["aom"],
          "platform": "!(android | ios)"
        }
      ]
    }
  }
}
