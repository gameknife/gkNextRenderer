plugins {
    id 'com.android.application'
}

def releaseSigningPropertiesPath = '@GK_ANDROID_SIGNING_PROPERTIES@'
def gkNextSourceAssetRoot = file('@GK_REPO_ROOT@/assets')
def releaseSigningPropertiesFile = releaseSigningPropertiesPath ? file(releaseSigningPropertiesPath) : null
def releaseSigningProperties = new Properties()
def releaseSigningEnabled = releaseSigningPropertiesFile != null && releaseSigningPropertiesFile.isFile()
if (releaseSigningEnabled) {
    releaseSigningPropertiesFile.withInputStream { releaseSigningProperties.load(it) }
}

android {
    namespace 'com.gknext.renderer'
    compileSdk 35
    ndkVersion '@GK_ANDROID_NDK_VERSION@'
    ndkPath '@GK_ANDROID_NDK_ROOT@'

    defaultConfig {
        applicationId 'com.gknext.renderer'
        minSdk 21
        targetSdk 35
        versionCode 1
        versionName '1.0'

        ndk {
            abiFilters '@GK_ANDROID_ABI@'
        }

        externalNativeBuild {
            cmake {
                targets 'gkNextRenderer'
                arguments '-DANDROID_STL=c++_shared',
                        '-DANDROID_PLATFORM=android-33',
                        '-DANDROID_NATIVE_API_LEVEL=33',
                        '-DVCPKG_CMAKE_SYSTEM_VERSION=33',
                        '-DVCPKG_TARGET_TRIPLET=arm64-android',
                        '-DCMAKE_TOOLCHAIN_FILE=@GK_VCPKG_TOOLCHAIN@',
                        '-DVCPKG_CHAINLOAD_TOOLCHAIN_FILE=@GK_NDK_TOOLCHAIN@',
                        '-DGK_ANDROID_ASSET_OUTPUT_DIR=@GK_ANDROID_ASSET_OUTPUT_DIR@',
                        '-DVulkan_SLANGC=@GK_SLANGC@'
            }
        }
    }

    externalNativeBuild {
        cmake {
            path file('@GK_REPO_ROOT@/CMakeLists.txt')
            buildStagingDirectory file('@GK_NATIVE_DIR@')
        }
    }

    sourceSets {
        main {
            assets.srcDirs = [file('@GK_ASSET_ROOT@')]
        }
    }

    signingConfigs {
        if (releaseSigningEnabled) {
            release {
                storeFile file(releaseSigningProperties['storeFile'])
                storePassword releaseSigningProperties['storePassword']
                keyAlias releaseSigningProperties['keyAlias']
                keyPassword releaseSigningProperties['keyPassword']
            }
        }
    }

    buildTypes {
        debug {
            buildConfigField 'boolean', 'DEBUG', 'true'
        }
        relWithDebInfo {
            initWith debug
            matchingFallbacks = ['debug']
            // Keep Android's debug signing/installability while asking the
            // native CMake project for its standard optimized-with-symbols
            // configuration.
            externalNativeBuild {
                cmake {
                    arguments '-DCMAKE_BUILD_TYPE=RelWithDebInfo'
                }
            }
        }
        release {
            minifyEnabled false
            buildConfigField 'boolean', 'DEBUG', 'false'
            externalNativeBuild {
                cmake {
                    arguments '-DCMAKE_BUILD_TYPE=Release'
                }
            }
            if (releaseSigningEnabled) {
                signingConfig signingConfigs.release
            }
        }
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_1_8
        targetCompatibility JavaVersion.VERSION_1_8
    }

    buildFeatures {
        prefab true
        buildConfig true
    }
}

dependencies {
    implementation files('@GK_SDL_AAR@')
}

afterEvaluate {
    // CMake generates Android assets as part of the external native build. Gradle's
    // merge task otherwise snapshots the generated directory before that dependency
    // creates new or changed files and may incorrectly reuse stale merged assets.
    ['Debug', 'RelWithDebInfo', 'Release'].each { variantName ->
        def nativeBuildTask = tasks.named("externalNativeBuild${variantName}")
        nativeBuildTask.configure {
            // Track the source tree explicitly so adding or editing an asset also
            // invalidates the external native build task. This includes untracked
            // files in the current working tree; Git commits are not build inputs.
            inputs.dir(gkNextSourceAssetRoot)
        }
        tasks.named("merge${variantName}Assets").configure {
            dependsOn nativeBuildTask
            // The input directory is populated by nativeBuildTask. Force a fresh
            // snapshot after it completes so newly generated assets reach the APK.
            outputs.upToDateWhen { false }
        }
    }
}
