{
  "name": "restir-m2-temporal",
  "target": "gkNextRenderer",
  "scene": "ManyLightsShowcase.proc",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 30000
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "wait-frames", "n": 30 },
    { "type": "log", "message": "Temporal reuse: raw frame (temporalFrames=1) after M accumulates should beat the M1 RIS-only shot" },
    { "type": "cvar", "name": "r.restir.enable", "set": true },
    { "type": "cvar", "name": "r.temporalFrames", "set": 1 },
    { "type": "wait-frames", "n": 40 },
    { "type": "screenshot", "out": "screenshots/restir_m2_temporal_raw" },
    { "type": "cvar", "name": "r.restir.debugMode", "set": 4 },
    { "type": "wait-frames", "n": 5 },
    { "type": "screenshot", "out": "screenshots/restir_m2_debug_hitrate" },
    { "type": "cvar", "name": "r.restir.debugMode", "set": 0 },
    { "type": "log", "message": "Camera motion: reuse must reproject without lag/ghost, then recover" },
    { "type": "mouse-move", "to": { "norm": [0.5, 0.5] } },
    { "type": "mouse-button", "button": "right", "action": "down", "at": { "norm": [0.5, 0.5] } },
    { "type": "mouse-move", "relative": true, "to": [150, 0], "durationFrames": 30 },
    { "type": "screenshot", "out": "screenshots/restir_m2_during_motion" },
    { "type": "mouse-button", "button": "right", "action": "up" },
    { "type": "wait-frames", "n": 30 },
    { "type": "screenshot", "out": "screenshots/restir_m2_after_motion" },
    { "type": "log", "message": "Renderer switch invalidation: no stale reservoir artifacts after switching back" },
    { "type": "cvar", "name": "r.rendererType", "set": 1 },
    { "type": "wait-frames", "n": 20 },
    { "type": "cvar", "name": "r.rendererType", "set": 0 },
    { "type": "wait-frames", "n": 15 },
    { "type": "screenshot", "out": "screenshots/restir_m2_after_switch" },
    { "type": "cvar", "name": "r.temporalFrames", "set": 16 },
    { "type": "cvar", "name": "r.restir.enable", "set": false },
    { "type": "wait-frames", "n": 5 },
    { "type": "quit" }
  ]
}
