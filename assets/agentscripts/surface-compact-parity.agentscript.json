{
  "name": "surface-compact-parity",
  "target": "gkNextRenderer",
  "scene": "assets/models/playground.glb",
  "defaults": {
    "waitFrames": 0,
    "stepTimeoutMs": 30000
  },
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "steps": [
    {
      "type": "wait-until",
      "query": "engine.status",
      "op": "eq",
      "value": "Running",
      "timeoutMs": 30000
    },
    {
      "type": "cvar",
      "name": "r.rendererType",
      "set": 4
    },
    {
      "type": "cvar",
      "name": "sys.tickPhysics",
      "set": false
    },
    {
      "type": "cvar",
      "name": "sys.tickAnimation",
      "set": false
    },
    {
      "type": "cvar",
      "name": "r.gtao.enable",
      "set": false
    },
    {
      "type": "cvar",
      "name": "r.gtao.applyInCore",
      "set": false
    },
    {
      "type": "cvar",
      "name": "r.upscaler.type",
      "set": 4
    },
    {
      "type": "cvar",
      "name": "r.upscaler.qualityMode",
      "set": 4
    },
    {
      "type": "cvar",
      "name": "r.surface.build",
      "set": true
    },
    {
      "type": "cvar",
      "name": "r.taau.sparseCheckerboard",
      "set": false
    },
    {
      "type": "cvar",
      "name": "r.checkerboardRendering",
      "set": true
    },
    {
      "type": "log",
      "message": "=== cb analytic A ==="
    },
    {
      "type": "cvar",
      "name": "r.surface.scheduler",
      "set": false
    },
    {
      "type": "wait-frames",
      "n": 60
    },
    {
      "type": "screenshot",
      "out": "screenshots/surface_compact_cb_analyticA"
    },
    {
      "type": "log",
      "message": "=== cb scheduler ==="
    },
    {
      "type": "cvar",
      "name": "r.surface.scheduler",
      "set": true
    },
    {
      "type": "wait-frames",
      "n": 60
    },
    {
      "type": "screenshot",
      "out": "screenshots/surface_compact_cb_scheduler"
    },
    {
      "type": "log",
      "message": "=== cb analytic B ==="
    },
    {
      "type": "cvar",
      "name": "r.surface.scheduler",
      "set": false
    },
    {
      "type": "wait-frames",
      "n": 60
    },
    {
      "type": "screenshot",
      "out": "screenshots/surface_compact_cb_analyticB"
    },
    {
      "type": "log",
      "message": "=== full analytic ==="
    },
    {
      "type": "cvar",
      "name": "r.checkerboardRendering",
      "set": false
    },
    {
      "type": "cvar",
      "name": "r.surface.scheduler",
      "set": false
    },
    {
      "type": "wait-frames",
      "n": 60
    },
    {
      "type": "screenshot",
      "out": "screenshots/surface_compact_full_analytic"
    },
    {
      "type": "log",
      "message": "=== full scheduler ==="
    },
    {
      "type": "cvar",
      "name": "r.surface.scheduler",
      "set": true
    },
    {
      "type": "wait-frames",
      "n": 60
    },
    {
      "type": "screenshot",
      "out": "screenshots/surface_compact_full_scheduler"
    },
    {
      "type": "quit"
    }
  ]
}
