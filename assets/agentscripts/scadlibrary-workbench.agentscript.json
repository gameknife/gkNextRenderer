{
  "name": "scadlibrary-workbench",
  "target": "ScadLibrary",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 30000
  },
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "steps": [
    {
      "type": "wait-until",
      "query": "engine.status",
      "op": "eq",
      "value": "Running",
      "timeoutMs": 20000
    },
    {
      "type": "wait-frames",
      "n": 60
    },
    {
      "type": "mouse-move",
      "to": {
        "norm": [0.384, 0.036]
      }
    },
    {
      "type": "wait-frames",
      "n": 5
    },
    {
      "type": "mouse-button",
      "button": "left",
      "action": "down"
    },
    {
      "type": "wait-frames",
      "n": 5
    },
    {
      "type": "mouse-button",
      "button": "left",
      "action": "up"
    },
    {
      "type": "mouse-move",
      "to": {
        "norm": [0.5, 0.3]
      }
    },
    {
      "type": "wait-frames",
      "n": 240
    },
    {
      "type": "assert",
      "query": "scene.nodeCount",
      "op": "ge",
      "value": 20
    },
    {
      "type": "screenshot",
      "out": "screenshots/scadlibrary_workbench",
      "ui": true
    },
    {
      "type": "mouse-move",
      "to": {
        "norm": [0.075, 0.223]
      }
    },
    {
      "type": "mouse-button",
      "button": "left",
      "action": "down"
    },
    {
      "type": "wait-frames",
      "n": 3
    },
    {
      "type": "mouse-button",
      "button": "left",
      "action": "up"
    },
    {
      "type": "wait-frames",
      "n": 10
    },
    {
      "type": "mouse-move",
      "to": {
        "norm": [0.448, 0.741]
      }
    },
    {
      "type": "mouse-button",
      "button": "left",
      "action": "down"
    },
    {
      "type": "wait-frames",
      "n": 3
    },
    {
      "type": "mouse-move",
      "to": {
        "norm": [0.41, 0.741]
      }
    },
    {
      "type": "wait-frames",
      "n": 5
    },
    {
      "type": "mouse-button",
      "button": "left",
      "action": "up"
    },
    {
      "type": "wait-frames",
      "n": 20
    },
    {
      "type": "screenshot",
      "out": "screenshots/scadlibrary_workbench_timeline",
      "ui": true
    },
    {
      "type": "mouse-move",
      "to": {
        "norm": [0.478, 0.189]
      }
    },
    {
      "type": "wait-frames",
      "n": 5
    },
    {
      "type": "mouse-button",
      "button": "left",
      "action": "down"
    },
    {
      "type": "wait-frames",
      "n": 3
    },
    {
      "type": "mouse-move",
      "to": {
        "norm": [0.469, 0.145]
      }
    },
    {
      "type": "wait-frames",
      "n": 8
    },
    {
      "type": "mouse-button",
      "button": "left",
      "action": "up"
    },
    {
      "type": "wait-frames",
      "n": 20
    },
    {
      "type": "screenshot",
      "out": "screenshots/scadlibrary_workbench_gizmo_key",
      "ui": true
    },
    {
      "type": "mouse-move",
      "to": {
        "norm": [0.795, 0.34]
      }
    },
    {
      "type": "mouse-button",
      "button": "left",
      "action": "down"
    },
    {
      "type": "wait-frames",
      "n": 3
    },
    {
      "type": "mouse-button",
      "button": "left",
      "action": "up"
    },
    {
      "type": "wait-frames",
      "n": 20
    },
    {
      "type": "screenshot",
      "out": "screenshots/scadlibrary_workbench_equipment",
      "ui": true
    },
    {
      "type": "quit"
    }
  ]
}
