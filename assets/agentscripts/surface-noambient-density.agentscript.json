{
  "name": "surface-noambient-density",
  "target": "gkNextRenderer",
  "scene": "assets/models/playground.glb",
  "defaults": {
    "waitFrames": 0,
    "stepTimeoutMs": 20000
  },
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "cvar", "name": "r.rendererType", "set": 4 },
    { "type": "cvar", "name": "sys.tickPhysics", "set": false },
    { "type": "cvar", "name": "sys.tickAnimation", "set": false },
    { "type": "cvar", "name": "r.upscaler.type", "set": 4 },
    { "type": "cvar", "name": "r.upscaler.qualityMode", "set": 4 },
    { "type": "cvar", "name": "r.gtao.enable", "set": true },
    { "type": "cvar", "name": "r.gtao.debugMode", "set": 1 },

    { "type": "cvar", "name": "r.checkerboardRendering", "set": false },
    { "type": "cvar", "name": "r.surface.build", "set": false },
    { "type": "wait-frames", "n": 60 },
    { "type": "screenshot", "out": "screenshots/surface_density_full_legacy" },

    { "type": "cvar", "name": "r.checkerboardRendering", "set": true },
    { "type": "wait-frames", "n": 60 },
    { "type": "screenshot", "out": "screenshots/surface_density_cb_legacy" },

    { "type": "cvar", "name": "r.checkerboardRendering", "set": false },
    { "type": "cvar", "name": "r.surface.build", "set": true },
    { "type": "wait-frames", "n": 60 },
    { "type": "screenshot", "out": "screenshots/surface_density_full_surface" },

    { "type": "cvar", "name": "r.checkerboardRendering", "set": true },
    { "type": "wait-frames", "n": 60 },
    { "type": "screenshot", "out": "screenshots/surface_density_cb_surface" },

    { "type": "quit" }
  ]
}
