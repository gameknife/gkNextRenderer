{
  "name": "atmosphere",
  "target": "gkNextRenderer",
  "scene": "AtmosphereTimeOfDay.proc",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 12000
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 12000 },
    { "type": "cvar", "name": "r.atmosphere.enable", "set": true },
    { "type": "cvar", "name": "r.atmosphere.aerialPerspective", "set": true },
    { "type": "cvar", "name": "r.atmosphere.heightFog", "set": true },
    { "type": "wait-frames", "n": 20 },
    { "type": "assert", "query": "cvar.r.atmosphere.enable", "op": "eq", "value": true },
    { "type": "assert", "query": "cvar.r.atmosphere.aerialPerspective", "op": "eq", "value": true },
    { "type": "assert", "query": "engine.frameRate", "op": "gt", "value": 1 },
    { "type": "assert", "query": "scene.sunElevation", "op": "gt", "value": 0.8 },
    { "type": "screenshot", "out": "screenshots/atmosphere_noon" },
    { "type": "wait-until", "query": "scene.sunElevation", "op": "lt", "value": 0.12, "timeoutMs": 12000 },
    { "type": "assert", "query": "scene.sunElevation", "op": "gt", "value": -0.08 },
    { "type": "screenshot", "out": "screenshots/atmosphere_sunset" },
    { "type": "wait-until", "query": "scene.sunElevation", "op": "lt", "value": -0.25, "timeoutMs": 12000 },
    { "type": "screenshot", "out": "screenshots/atmosphere_night" },
    { "type": "cvar", "name": "r.atmosphere.debugMode", "set": 2 },
    { "type": "wait-frames", "n": 4 },
    { "type": "screenshot", "out": "screenshots/atmosphere_transmittance" },
    { "type": "cvar", "name": "r.atmosphere.debugMode", "set": 3 },
    { "type": "wait-frames", "n": 4 },
    { "type": "screenshot", "out": "screenshots/atmosphere_sky_lut" },
    { "type": "cvar", "name": "r.atmosphere.debugMode", "set": 0 },
    { "type": "quit" }
  ]
}
