{
  "name": "nexttotalwar-select",
  "target": "NextTotalwar",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 30000
  },
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "steps": [
    {"type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 30000},
    {"type": "wait-until", "query": "game.regimentCount", "op": "eq", "value": 24, "timeoutMs": 60000},
    {"type": "assert", "query": "game.soldierCount", "op": "eq", "value": 2400},
    {"type": "assert", "query": "game.renderProxyCount", "op": "ge", "value": 14000},
    {"type": "wait-frames", "n": 20},
    {"type": "mouse-move", "to": {"norm": [0.145, 0.95]}},
    {"type": "mouse-button", "button": "left", "action": "down", "at": {"norm": [0.145, 0.95]}},
    {"type": "mouse-button", "button": "left", "action": "up", "at": {"norm": [0.145, 0.95]}},
    {"type": "wait-frames", "n": 2},
    {"type": "cvar", "name": "tw.validation.selectPlayer", "set": true},
    {"type": "wait-frames", "n": 2},
    {"type": "assert", "query": "game.selectedRegiments", "op": "eq", "value": 1},
    {"type": "key", "code": "F", "action": "press"},
    {"type": "assert", "query": "game.cameraFollowing", "op": "eq", "value": true},
    {"type": "assert", "query": "game.cameraFollowError", "op": "le", "value": 0.01},
    {"type": "key", "code": "F", "action": "press"},
    {"type": "assert", "query": "game.cameraFollowing", "op": "eq", "value": false},
    {"type": "drag", "from": {"norm": [0.04, 0.30]}, "to": {"norm": [0.49, 0.76]}, "button": "left"},
    {"type": "cvar", "name": "tw.validation.selectPlayer", "set": true},
    {"type": "wait-frames", "n": 2},
    {"type": "assert", "query": "game.selectedRegiments", "op": "ge", "value": 1},
    {"type": "mouse-move", "to": {"norm": [0.62, 0.48]}},
    {"type": "mouse-button", "button": "right", "action": "down", "at": {"norm": [0.62, 0.48]}},
    {"type": "mouse-move", "to": {"norm": [0.70, 0.48]}},
    {"type": "wait-frames", "n": 2},
    {"type": "screenshot", "out": "screenshots/nexttotalwar-order-preview", "ui": true},
    {"type": "mouse-button", "button": "right", "action": "up", "at": {"norm": [0.70, 0.48]}},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.playerMarchingRegiments", "op": "ge", "value": 1},
    {"type": "screenshot", "out": "screenshots/nexttotalwar-select", "ui": true},
    {"type": "quit"}
  ]
}
