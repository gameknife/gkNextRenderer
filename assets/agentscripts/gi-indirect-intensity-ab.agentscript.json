{
  "name": "gi-indirect-intensity-ab",
  "target": "gkNextRenderer",
  "scene": "assets/models/playground.glb",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 30000
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "steps": [
    {
      "type": "wait-until",
      "query": "engine.status",
      "op": "eq",
      "value": "Running",
      "timeoutMs": 20000
    },
    {
      "type": "cvar",
      "name": "r.rendererType",
      "set": 0
    },
    {
      "type": "wait-frames",
      "n": 90
    },
    {
      "type": "cvar",
      "name": "r.gi.indirectIntensity",
      "set": 1.0
    },
    {
      "type": "wait-frames",
      "n": 60
    },
    {
      "type": "screenshot",
      "out": "screenshots/gi_indirect_1x"
    },
    {
      "type": "cvar",
      "name": "r.gi.indirectIntensity",
      "set": 4.0
    },
    {
      "type": "wait-frames",
      "n": 60
    },
    {
      "type": "screenshot",
      "out": "screenshots/gi_indirect_4x"
    },
    {
      "type": "cvar",
      "name": "r.gi.indirectIntensity",
      "set": 0.0
    },
    {
      "type": "wait-frames",
      "n": 60
    },
    {
      "type": "screenshot",
      "out": "screenshots/gi_indirect_0x"
    },
    {
      "type": "cvar",
      "name": "r.gi.indirectIntensity",
      "set": 1.0
    },
    {
      "type": "quit"
    }
  ]
}
