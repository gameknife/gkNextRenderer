{
  "name": "surface-noambient-ab",
  "target": "gkNextRenderer",
  "scene": "assets/models/playground.glb",
  "defaults": {
    "waitFrames": 0,
    "stepTimeoutMs": 15000
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 15000 },
    { "type": "cvar", "name": "r.upscaler.type", "set": 4 },
    { "type": "cvar", "name": "r.upscaler.qualityMode", "set": 4 },
    { "type": "cvar", "name": "r.rendererType", "set": 4 },
    { "type": "cvar", "name": "r.gtao.enable", "set": true },
    { "type": "cvar", "name": "r.lightObject.screenSpaceShadow", "set": true },

    { "type": "cvar", "name": "r.checkerboardRendering", "set": false },
    { "type": "cvar", "name": "r.surface.build", "set": false },
    { "type": "wait-frames", "n": 30 },
    { "type": "screenshot", "out": "screenshots/surface_ab_full_legacy" },

    { "type": "cvar", "name": "r.surface.build", "set": true },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "cvar.r.surface.build", "op": "eq", "value": true },
    { "type": "screenshot", "out": "screenshots/surface_ab_full_surface" },

    { "type": "cvar", "name": "r.checkerboardRendering", "set": true },
    { "type": "cvar", "name": "r.surface.build", "set": false },
    { "type": "wait-frames", "n": 30 },
    { "type": "screenshot", "out": "screenshots/surface_ab_cb_legacy" },

    { "type": "cvar", "name": "r.surface.build", "set": true },
    { "type": "wait-frames", "n": 30 },
    { "type": "screenshot", "out": "screenshots/surface_ab_cb_surface" },

    { "type": "assert", "query": "engine.totalFrames", "op": "ge", "value": 120 },
    { "type": "quit" }
  ]
}
