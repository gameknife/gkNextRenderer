{
  "name": "restir-m1-noclamp-restir",
  "target": "gkNextRenderer",
  "scene": "CornellBox.proc",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 120000
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "steps": [
    {
      "type": "wait-until",
      "query": "engine.status",
      "op": "eq",
      "value": "Running",
      "timeoutMs": 20000
    },
    {
      "type": "cvar",
      "name": "r.reproject.clampGammaHi",
      "set": 50.0
    },
    {
      "type": "cvar",
      "name": "r.reproject.clampGammaLo",
      "set": 50.0
    },
    {
      "type": "cvar",
      "name": "r.reproject.clampFloor",
      "set": 0.0
    },
    {
      "type": "cvar",
      "name": "r.restir.enable",
      "set": true
    },
    {
      "type": "cvar",
      "name": "r.temporalFrames",
      "set": 1024
    },
    {
      "type": "wait-frames",
      "n": 20
    },
    {
      "type": "log",
      "message": "Bias arm: ReSTIR RIS-only accumulated 600 frames, static camera; must match the NEE reference"
    },
    {
      "type": "wait-frames",
      "n": 600
    },
    {
      "type": "screenshot",
      "out": "screenshots/restir_m1_noclamp_restir"
    },
    {
      "type": "cvar",
      "name": "r.temporalFrames",
      "set": 16
    },
    {
      "type": "cvar",
      "name": "r.restir.enable",
      "set": false
    },
    {
      "type": "wait-frames",
      "n": 5
    },
    {
      "type": "cvar",
      "name": "r.reproject.clampGammaHi",
      "set": 2.5
    },
    {
      "type": "cvar",
      "name": "r.reproject.clampGammaLo",
      "set": 5.0
    },
    {
      "type": "cvar",
      "name": "r.reproject.clampFloor",
      "set": 0.5
    },
    {
      "type": "quit"
    }
  ]
}