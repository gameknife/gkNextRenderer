{
  "name": "nextdayz-product-loop",
  "target": "NextDayz",
  "scene": "assets/scad/proc/coldwar/riverland_1km.scad",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 20000 },
  "viewport": { "width": 1600, "height": 900 },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "wait-frames", "n": 60 },
    { "type": "assert", "query": "game.equippedWeapon", "op": "eq", "value": "" },
    { "type": "cvar", "name": "nextdayz.validation.addBackpack", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.addSupplies", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.loadout", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.spawnZombie", "set": true },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "game.inventoryCapacity", "op": "eq", "value": 38 },
    { "type": "assert", "query": "game.activeZombies", "op": "ge", "value": 1 },
    { "type": "mouse-button", "button": "left", "action": "down" },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "mouse-button", "button": "left", "action": "up" },
    { "type": "wait-frames", "n": 20 },
    { "type": "cvar", "name": "nextdayz.validation.finishZombie", "set": true },
    { "type": "assert", "query": "game.zombieKills", "op": "ge", "value": 1 },
    { "type": "cvar", "name": "nextdayz.validation.hydration", "set": 10 },
    { "type": "cvar", "name": "nextdayz.validation.useWater", "set": true },
    { "type": "wait-ms", "ms": 1800 },
    { "type": "assert", "query": "game.hydration", "op": "gt", "value": 40 },
    { "type": "screenshot", "out": "screenshots/nextdayz_product_loop", "ui": true },
    { "type": "cvar", "name": "nextdayz.validation.damagePlayer", "set": 200 },
    { "type": "assert", "query": "game.runState", "op": "eq", "value": "dead" },
    { "type": "cvar", "name": "nextdayz.validation.restart", "set": true },
    { "type": "wait-frames", "n": 5 },
    { "type": "assert", "query": "game.runState", "op": "eq", "value": "playing" },
    { "type": "assert", "query": "game.lootRemaining", "op": "eq", "value": 59 },
    { "type": "quit" }
  ]
}
