{
  "name": "checkerboard-renderers-smoke",
  "target": "gkNextRenderer",
  "scene": "assets/models/playground.glb",
  "defaults": {
    "waitFrames": 0,
    "stepTimeoutMs": 15000
  },
  "viewport": {
    "width": 960,
    "height": 540
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 10000 },
    { "type": "cvar", "name": "r.restir.enable", "set": false },
    { "type": "cvar", "name": "r.upscaler.type", "set": 4 },
    { "type": "cvar", "name": "r.upscaler.qualityMode", "set": 4 },
    { "type": "cvar", "name": "r.checkerboardRendering", "set": true },
    { "type": "cvar", "name": "r.rendererType", "set": 0 },
    { "type": "wait-frames", "n": 12 },
    { "type": "cvar", "name": "r.rendererType", "set": 1 },
    { "type": "wait-frames", "n": 12 },
    { "type": "cvar", "name": "r.rendererType", "set": 2 },
    { "type": "wait-frames", "n": 12 },
    { "type": "cvar", "name": "r.rendererType", "set": 4 },
    { "type": "wait-frames", "n": 12 },
    { "type": "assert", "query": "cvar.r.checkerboardRendering", "op": "eq", "value": true },
    { "type": "assert", "query": "engine.totalFrames", "op": "ge", "value": 48 },
    { "type": "quit" }
  ]
}
