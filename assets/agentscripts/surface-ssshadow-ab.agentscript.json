{
  "name": "surface-ssshadow-ab",
  "target": "gkNextRenderer",
  "scene": "assets/models/conf_room.glb",
  "defaults": {
    "waitFrames": 0,
    "stepTimeoutMs": 30000
  },
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 30000 },
    { "type": "cvar", "name": "r.rendererType", "set": 4 },
    { "type": "cvar", "name": "sys.tickPhysics", "set": false },
    { "type": "cvar", "name": "sys.tickAnimation", "set": false },
    { "type": "cvar", "name": "r.upscaler.type", "set": 0 },
    { "type": "cvar", "name": "r.checkerboardRendering", "set": false },
    { "type": "cvar", "name": "r.gtao.enable", "set": false },
    { "type": "cvar", "name": "r.lightObject.maxShadowedLights", "set": 2 },
    { "type": "cvar", "name": "r.lightObject.screenSpaceShadowSteps", "set": 12 },
    { "type": "wait-frames", "n": 30 },

    { "type": "mouse-move", "to": { "norm": [0.5, 0.5] } },
    { "type": "mouse-button", "button": "right", "action": "down", "at": { "norm": [0.5, 0.5] } },
    { "type": "wait-ms", "ms": 300 },
    { "type": "key", "code": "S", "action": "down" },
    { "type": "wait-ms", "ms": 1600 },
    { "type": "key", "code": "S", "action": "up" },
    { "type": "mouse-move", "relative": true, "to": [0, 60] },
    { "type": "wait-ms", "ms": 400 },
    { "type": "mouse-button", "button": "right", "action": "up" },
    { "type": "wait-frames", "n": 30 },

    { "type": "log", "message": "=== ss shadow off (reference) ===" },
    { "type": "cvar", "name": "r.lightObject.screenSpaceShadow", "set": false },
    { "type": "cvar", "name": "r.surface.build", "set": false },
    { "type": "wait-frames", "n": 60 },
    { "type": "assert", "query": "engine.gpuTime.shadingpass", "op": "ge", "value": 0 },
    { "type": "assert", "query": "engine.gpuTime.surface build", "op": "ge", "value": 0 },
    { "type": "assert", "query": "engine.frameRate", "op": "ge", "value": 0 },
    { "type": "screenshot", "out": "screenshots/surface_sss_none" },

    { "type": "log", "message": "=== ss shadow on, legacy ===" },
    { "type": "cvar", "name": "r.lightObject.screenSpaceShadow", "set": true },
    { "type": "wait-frames", "n": 60 },
    { "type": "assert", "query": "engine.gpuTime.shadingpass", "op": "ge", "value": 0 },
    { "type": "assert", "query": "engine.gpuTime.surface build", "op": "ge", "value": 0 },
    { "type": "assert", "query": "engine.frameRate", "op": "ge", "value": 0 },
    { "type": "screenshot", "out": "screenshots/surface_sss_legacy" },

    { "type": "log", "message": "=== ss shadow on, surface ===" },
    { "type": "cvar", "name": "r.surface.build", "set": true },
    { "type": "wait-frames", "n": 60 },
    { "type": "assert", "query": "engine.gpuTime.shadingpass", "op": "ge", "value": 0 },
    { "type": "assert", "query": "engine.gpuTime.surface build", "op": "ge", "value": 0 },
    { "type": "assert", "query": "engine.frameRate", "op": "ge", "value": 0 },
    { "type": "screenshot", "out": "screenshots/surface_sss_surface" },

    { "type": "log", "message": "=== ss shadow off, surface (isolate march cost) ===" },
    { "type": "cvar", "name": "r.lightObject.screenSpaceShadow", "set": false },
    { "type": "wait-frames", "n": 60 },
    { "type": "assert", "query": "engine.gpuTime.shadingpass", "op": "ge", "value": 0 },
    { "type": "assert", "query": "engine.gpuTime.surface build", "op": "ge", "value": 0 },
    { "type": "assert", "query": "engine.frameRate", "op": "ge", "value": 0 },
    { "type": "screenshot", "out": "screenshots/surface_sss_none_surface" },

    { "type": "quit" }
  ]
}
