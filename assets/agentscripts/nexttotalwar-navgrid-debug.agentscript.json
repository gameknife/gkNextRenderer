{
  "name": "nexttotalwar-navgrid-debug",
  "target": "NextTotalwar",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 30000
  },
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "steps": [
    {"type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 30000},
    {"type": "wait-until", "query": "game.navReady", "op": "eq", "value": true, "timeoutMs": 60000},
    {"type": "key", "code": "F6", "action": "press"},
    {"type": "wait-frames", "n": 3},
    {"type": "assert", "query": "game.navGridVisible", "op": "eq", "value": true},
    {"type": "screenshot", "out": "screenshots/nexttotalwar-navgrid-debug", "ui": true},
    {"type": "key", "code": "F6", "action": "press"},
    {"type": "assert", "query": "game.navGridVisible", "op": "eq", "value": false},
    {"type": "quit"}
  ]
}
