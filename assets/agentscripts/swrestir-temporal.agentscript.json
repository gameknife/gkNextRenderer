{
  "name": "swrestir-temporal",
  "target": "gkNextRenderer",
  "scene": "ManyLightsShowcase.proc",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 30000
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "cvar", "name": "r.rendererType", "set": 1 },
    { "type": "cvar", "name": "r.restir.enable", "set": true },
    { "type": "cvar", "name": "r.restir.temporal", "set": true },
    { "type": "cvar", "name": "r.restir.spatial", "set": true },
    { "type": "cvar", "name": "r.temporalFrames", "set": 1 },
    { "type": "wait-frames", "n": 40 },
    { "type": "screenshot", "out": "screenshots/swrestir_temporal_static" },
    { "type": "cvar", "name": "r.restir.debugMode", "set": 4 },
    { "type": "wait-frames", "n": 5 },
    { "type": "screenshot", "out": "screenshots/swrestir_temporal_reuse" },
    { "type": "cvar", "name": "r.restir.debugMode", "set": 0 },
    { "type": "mouse-move", "to": { "norm": [0.5, 0.5] } },
    { "type": "mouse-button", "button": "right", "action": "down", "at": { "norm": [0.5, 0.5] } },
    { "type": "mouse-move", "relative": true, "to": [150, 0], "durationFrames": 30 },
    { "type": "screenshot", "out": "screenshots/swrestir_temporal_during_motion" },
    { "type": "mouse-button", "button": "right", "action": "up" },
    { "type": "wait-frames", "n": 30 },
    { "type": "screenshot", "out": "screenshots/swrestir_temporal_after_motion" },
    { "type": "assert", "query": "engine.rendererType", "op": "eq", "value": 1 },
    { "type": "cvar", "name": "r.temporalFrames", "set": 16 },
    { "type": "cvar", "name": "r.restir.enable", "set": false },
    { "type": "quit" }
  ]
}
