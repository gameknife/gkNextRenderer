{
  "name": "swtracing-restir-removed",
  "target": "gkNextRenderer",
  "scene": "assets/models/playground.glb",
  "defaults": {
    "waitFrames": 0,
    "stepTimeoutMs": 60000
  },
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "steps": [
    {
      "type": "wait-until",
      "query": "engine.status",
      "op": "eq",
      "value": "Running",
      "timeoutMs": 30000
    },
    {
      "type": "cvar",
      "name": "r.rendererType",
      "set": 1
    },
    {
      "type": "cvar",
      "name": "sys.tickPhysics",
      "set": false
    },
    {
      "type": "cvar",
      "name": "sys.tickAnimation",
      "set": false
    },
    {
      "type": "cvar",
      "name": "r.upscaler.type",
      "set": 4
    },
    {
      "type": "cvar",
      "name": "r.upscaler.qualityMode",
      "set": 4
    },
    {
      "type": "cvar",
      "name": "r.samples",
      "set": 2
    },
    {
      "type": "log",
      "message": "=== restir_off | full | analytic ==="
    },
    {
      "type": "cvar",
      "name": "r.restir.enable",
      "set": false
    },
    {
      "type": "cvar",
      "name": "r.checkerboardRendering",
      "set": false
    },
    {
      "type": "wait-frames",
      "n": 180
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.shadingpass",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.shading classify",
      "op": "ge",
      "value": 0
    },
    {
      "type": "wait-frames",
      "n": 180
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.shadingpass",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.shading classify",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.frameRate",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.checkerboardActive",
      "op": "ge",
      "value": ""
    },
    {
      "type": "screenshot",
      "out": "screenshots/surface_norestir_restir_off_full_analytic"
    },
    {
      "type": "log",
      "message": "=== restir_off | full | scheduler ==="
    },
    {
      "type": "cvar",
      "name": "r.restir.enable",
      "set": false
    },
    {
      "type": "cvar",
      "name": "r.checkerboardRendering",
