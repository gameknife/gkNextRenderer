    },
    {
      "type": "wait-frames",
      "n": 180
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.shadingpass",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.shading classify",
      "op": "ge",
      "value": 0
    },
    {
      "type": "wait-frames",
      "n": 180
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.shadingpass",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
