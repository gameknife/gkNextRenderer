{
  "name": "nextdayz-debug-visualization",
  "target": "NextDayz",
  "scene": "assets/scad/proc/coldwar/riverland_1km.scad",
  "viewport": { "width": 1600, "height": 900 },
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 30000 },
  "steps": [
    { "type": "wait-until", "query": "game.worldLootAnchors", "op": "ge", "value": 1, "timeoutMs": 120000 },
    { "type": "cvar", "name": "nextdayz.validation.loadout", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.spawnZombie", "set": true },
    { "type": "key", "code": "F5", "action": "press" },
    { "type": "wait-frames", "n": 4 },
    { "type": "assert", "query": "game.debugVisible", "op": "eq", "value": true },
    { "type": "assert", "query": "game.debugZombieOverlay", "op": "eq", "value": true },
    { "type": "assert", "query": "game.debugLootOverlay", "op": "eq", "value": true },
    { "type": "assert", "query": "game.debugHitProxyOverlay", "op": "eq", "value": true },
    { "type": "assert", "query": "game.hitProxyRegistered", "op": "ge", "value": 1 },
    { "type": "assert", "query": "game.lootDebugEntries", "op": "ge", "value": 50 },
    { "type": "screenshot", "out": "screenshots/nextdayz_debug_world", "ui": true },
    { "type": "mouse-button", "button": "left", "action": "down" },
    { "type": "wait-ms", "ms": 120 },
    { "type": "mouse-button", "button": "left", "action": "up" },
    { "type": "wait-frames", "n": 4 },
    { "type": "assert", "query": "game.recentWeaponTraces", "op": "ge", "value": 1 },
    { "type": "screenshot", "out": "screenshots/nextdayz_debug_shot", "ui": true },
    { "type": "quit" }
  ]
}
