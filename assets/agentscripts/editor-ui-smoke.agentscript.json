{
  "name": "editor-ui-smoke",
  "target": "gkNextEditor",
  "scene": "assets/models/playground.glb",
  "viewport": {
    "width": 1724,
    "height": 969
  },
  "defaults": {
    "waitFrames": 5,
    "stepTimeoutMs": 30000
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running" },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "scene.nodeCount", "op": "gt", "value": 0, "comment": "Scene committed" },
    { "type": "mouse-move", "to": { "norm": [0.08, 0.42] }, "comment": "Outliner row, below the mode tabs / search / type pills" },
    { "type": "wait-frames", "n": 5 },
    { "type": "mouse-button", "button": "left", "action": "down" },
    { "type": "wait-frames", "n": 5 },
    { "type": "mouse-button", "button": "left", "action": "up" },
    { "type": "wait-frames", "n": 15 },
    { "type": "assert", "query": "scene.selectedCount", "op": "ge", "value": 1, "comment": "Clicking an Outliner row selects a node; fails if the toolbar rows above the tree shift the hit point" },
    { "type": "screenshot", "ui": true, "out": "screenshots/editor_selected" },
    { "type": "quit" }
  ]
}
