{
  "name": "nextastrobot-goal",
  "target": "NextAstrobot",
  "scene": "assets/scad/source/astro/sky_garden.scad",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 20000 },
  "viewport": { "width": 1600, "height": 900 },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "wait-frames", "n": 30 },
    { "type": "cvar", "name": "astro.state", "set": "playing" },
    { "type": "wait-frames", "n": 40 },
    { "type": "assert", "query": "game.checkpoint", "op": "eq", "value": -1 },
    { "type": "assert", "query": "game.rescued", "op": "eq", "value": 0 },
    { "type": "assert", "query": "game.rescuedTotal", "op": "eq", "value": 4 },

    { "type": "log", "message": "walking up to a stranded robot frees it after a short hold" },
    { "type": "cvar", "name": "astro.teleport", "set": "-46,0.3,8" },
    { "type": "wait-ms", "ms": 900 },
    { "type": "assert", "query": "game.rescued", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.rescueRigs", "op": "eq", "value": 1 },

    { "type": "log", "message": "a punch smashes a crate and spills its coins" },
    { "type": "cvar", "name": "astro.teleport", "set": "-50,0.3,-8" },
    { "type": "wait-frames", "n": 30 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 250 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "wait-frames", "n": 10 },
    { "type": "key", "code": "X", "action": "press" },
    { "type": "wait-frames", "n": 20 },
    { "type": "assert", "query": "game.coins", "op": "ge", "value": 3 },
    { "type": "wait-until", "query": "game.punching", "op": "eq", "value": false, "timeoutMs": 4000 },

    { "type": "log", "message": "the pillar cage opens to a punch and frees the robot inside" },
    { "type": "cvar", "name": "astro.ride", "set": "cage" },
    { "type": "wait-frames", "n": 40 },
    { "type": "assert", "query": "game.onGround", "op": "eq", "value": true },
    { "type": "assert", "query": "game.punching", "op": "eq", "value": false },
    { "type": "key", "code": "X", "action": "press" },
    { "type": "wait-frames", "n": 20 },
    { "type": "assert", "query": "game.rescued", "op": "ge", "value": 2 },
    { "type": "assert", "query": "game.rescueRigs", "op": "ge", "value": 2 },
    { "type": "wait-until", "query": "game.mech.cage.t", "op": "ge", "value": 0.9, "timeoutMs": 4000 },
    { "type": "screenshot", "out": "screenshots/nextastrobot_cage", "ui": true },

    { "type": "log", "message": "checkpoints move the respawn point along the level" },
    { "type": "cvar", "name": "astro.teleport", "set": "-15,3.3,-2" },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "game.checkpoint", "op": "eq", "value": 1 },
    { "type": "cvar", "name": "astro.teleport", "set": "35,3.3,-7.5" },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "game.checkpoint", "op": "eq", "value": 2 },

    { "type": "log", "message": "dying now respawns at checkpoint 2, not back at the landing pad" },
    { "type": "cvar", "name": "astro.teleport", "set": "35,-60,-7.5" },
    { "type": "wait-until", "query": "game.deaths", "op": "eq", "value": 1, "timeoutMs": 8000 },
    { "type": "wait-until", "query": "game.state", "op": "eq", "value": "playing", "timeoutMs": 8000 },
    { "type": "assert", "query": "game.playerX", "op": "gt", "value": 33.0 },

    { "type": "log", "message": "reaching the goal arch ends the run and shows the result screen" },
    { "type": "cvar", "name": "astro.teleport", "set": "56,3.3,0" },
    { "type": "wait-until", "query": "game.state", "op": "eq", "value": "goal", "timeoutMs": 6000 },
    { "type": "screenshot", "out": "screenshots/nextastrobot_goal", "ui": true },
    { "type": "wait-until", "query": "game.state", "op": "eq", "value": "result", "timeoutMs": 8000 },
    { "type": "assert", "query": "game.deaths", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.rescued", "op": "ge", "value": 2 },
    { "type": "screenshot", "out": "screenshots/nextastrobot_result", "ui": true },
    { "type": "quit" }
  ]
}
