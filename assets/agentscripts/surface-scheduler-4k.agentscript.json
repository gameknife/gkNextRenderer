      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.checkerboard resolve",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.simplecompose pass",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.frameRate",
      "op": "ge",
      "value": 0
    },
    {
      "type": "screenshot",
      "out": "screenshots/surface_m4_4k_full_scheduler"
    },
    {
      "type": "log",
      "message": "=== 4k | cb | analytic ==="
