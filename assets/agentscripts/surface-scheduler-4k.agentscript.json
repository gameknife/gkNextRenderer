{
  "name": "surface-scheduler-4k",
  "target": "gkNextRenderer",
  "scene": "assets/models/playground.glb",
  "defaults": {
    "waitFrames": 0,
    "stepTimeoutMs": 30000
  },
  "viewport": {
    "width": 3840,
    "height": 2160
  },
  "steps": [
    {
      "type": "wait-until",
      "query": "engine.status",
      "op": "eq",
      "value": "Running",
      "timeoutMs": 30000
    },
    {
      "type": "cvar",
      "name": "r.rendererType",
      "set": 4
    },
    {
      "type": "cvar",
      "name": "sys.tickPhysics",
      "set": false
    },
    {
      "type": "cvar",
      "name": "sys.tickAnimation",
      "set": false
    },
    {
      "type": "cvar",
      "name": "r.upscaler.qualityMode",
      "set": 4
    },
    {
      "type": "cvar",
      "name": "r.gtao.enable",
      "set": true
    },
    {
      "type": "log",
      "message": "=== 4k | full | analytic ==="
    },
    {
      "type": "cvar",
      "name": "r.upscaler.type",
      "set": 0
    },
    {
      "type": "cvar",
      "name": "r.checkerboardRendering",
      "set": false
    },
    {
      "type": "cvar",
      "name": "r.surface.build",
      "set": true
    },
    {
      "type": "cvar",
      "name": "r.surface.scheduler",
      "set": false
    },
    {
      "type": "wait-frames",
      "n": 120
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.surface build",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.shading classify",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.shadingpass",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.gtao pass",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.checkerboard resolve",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.simplecompose pass",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.frameRate",
      "op": "ge",
      "value": 0
    },
    {
      "type": "screenshot",
      "out": "screenshots/surface_m4_4k_full_analytic"
    },
    {
      "type": "log",
      "message": "=== 4k | full | scheduler ==="
    },
    {
      "type": "cvar",
      "name": "r.upscaler.type",
      "set": 0
    },
    {
      "type": "cvar",
      "name": "r.checkerboardRendering",
      "set": false
    },
    {
      "type": "cvar",
      "name": "r.surface.build",
      "set": true
    },
    {
      "type": "cvar",
