{
  "name": "nextastrobot-levels",
  "target": "NextAstrobot",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 20000 },
  "viewport": { "width": 1600, "height": 900 },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "wait-frames", "n": 30 },

    { "type": "log", "message": "a run starts on the first level of the list" },
    { "type": "assert", "query": "game.levelCount", "op": "eq", "value": 3 },
    { "type": "assert", "query": "game.level", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.levelId", "op": "eq", "value": "sky_garden" },
    { "type": "assert", "query": "game.campaignCoins", "op": "eq", "value": 0 },

    { "type": "log", "message": "finishing a level tallies it into the run total" },
    { "type": "cvar", "name": "astro.state", "set": "playing" },
    { "type": "wait-frames", "n": 30 },
    { "type": "cvar", "name": "astro.teleport", "set": "-53.5,0.4,0" },
    { "type": "wait-frames", "n": 20 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 1600 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "assert", "query": "game.coins", "op": "eq", "value": 5 },
    { "type": "cvar", "name": "astro.state", "set": "result" },
    { "type": "wait-until", "query": "game.state", "op": "eq", "value": "result", "timeoutMs": 8000 },
    { "type": "assert", "query": "game.campaignCoins", "op": "eq", "value": 5 },
    { "type": "screenshot", "out": "screenshots/nextastrobot_result_next", "ui": true },

    { "type": "log", "message": "[Space] on the result screen loads the next level (dune_relay)" },
    { "type": "key", "code": "SPACE", "action": "press" },
    { "type": "wait-until", "query": "game.levelId", "op": "eq", "value": "dune_relay", "timeoutMs": 20000 },
    { "type": "wait-until", "query": "game.state", "op": "eq", "value": "title", "timeoutMs": 20000 },
    { "type": "assert", "query": "game.level", "op": "eq", "value": 2 },
    { "type": "assert", "query": "game.index.warnings", "op": "eq", "value": 0 },
    { "type": "assert", "query": "game.campaignCoins", "op": "eq", "value": 5 },
    { "type": "assert", "query": "game.coins", "op": "eq", "value": 0 },

    { "type": "log", "message": "dune_relay is a complete level in its own right" },
    { "type": "cvar", "name": "astro.state", "set": "playing" },
    { "type": "wait-frames", "n": 40 },
    { "type": "assert", "query": "game.coinsTotal", "op": "ge", "value": 40 },
    { "type": "assert", "query": "game.puzzlesTotal", "op": "eq", "value": 3 },
    { "type": "assert", "query": "game.rescuedTotal", "op": "eq", "value": 3 },
    { "type": "assert", "query": "game.index.mechanisms", "op": "ge", "value": 15 },
    { "type": "assert", "query": "game.enemiesAlive", "op": "eq", "value": 3 },

    { "type": "log", "message": "its gate only opens to the lever, and the fan carries the canyon jump" },
    { "type": "assert", "query": "game.mech.gate_1.t", "op": "lt", "value": 0.05 },
    { "type": "cvar", "name": "astro.ride", "set": "lever_1" },
    { "type": "wait-frames", "n": 30 },
    { "type": "key", "code": "X", "action": "press" },
    { "type": "wait-until", "query": "game.mech.gate_1.t", "op": "ge", "value": 0.95, "timeoutMs": 4000 },
    { "type": "cvar", "name": "astro.teleport", "set": "-28.5,1.1,-0.5" },
    { "type": "wait-ms", "ms": 1200 },
    { "type": "wait-until", "query": "game.playerX", "op": "gt", "value": -26.5, "timeoutMs": 6000 },

    { "type": "log", "message": "checkpoint, fountain and spike ball all work on the new level too" },
    { "type": "cvar", "name": "astro.teleport", "set": "-11,3.4,0" },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "game.checkpoint", "op": "eq", "value": 1 },
    { "type": "wait-until", "query": "game.mech.flag_1.t", "op": "ge", "value": 0.95, "timeoutMs": 4000 },
    { "type": "cvar", "name": "astro.ride", "set": "fountain" },
    { "type": "wait-until", "query": "game.playerY", "op": "gt", "value": 7.0, "timeoutMs": 6000 },
    { "type": "wait-frames", "n": 20 },
    { "type": "screenshot", "out": "screenshots/nextastrobot_dune", "ui": false },
    { "type": "cvar", "name": "astro.ride", "set": "spikeball" },
    { "type": "wait-until", "query": "game.deaths", "op": "ge", "value": 1, "timeoutMs": 10000 },

    { "type": "log", "message": "[Space] on dune_relay loads level 3: frost_peak" },
    { "type": "wait-ms", "ms": 2500 },
    { "type": "cvar", "name": "astro.state", "set": "result" },
    { "type": "wait-until", "query": "game.state", "op": "eq", "value": "result", "timeoutMs": 8000 },
    { "type": "assert", "query": "game.campaignDeaths", "op": "ge", "value": 1 },
    { "type": "key", "code": "SPACE", "action": "press" },
    { "type": "wait-until", "query": "game.levelId", "op": "eq", "value": "frost_peak", "timeoutMs": 20000 },
    { "type": "wait-until", "query": "game.state", "op": "eq", "value": "title", "timeoutMs": 20000 },
    { "type": "assert", "query": "game.level", "op": "eq", "value": 3 },
    { "type": "assert", "query": "game.index.warnings", "op": "eq", "value": 0 },

    { "type": "log", "message": "frost_peak is fully populated with snow/ice theme assets and mechanisms" },
    { "type": "cvar", "name": "astro.state", "set": "playing" },
    { "type": "wait-frames", "n": 40 },
    { "type": "assert", "query": "game.coinsTotal", "op": "ge", "value": 40 },
    { "type": "assert", "query": "game.puzzlesTotal", "op": "eq", "value": 3 },
    { "type": "assert", "query": "game.rescuedTotal", "op": "eq", "value": 3 },
    { "type": "assert", "query": "game.index.mechanisms", "op": "ge", "value": 15 },
    { "type": "assert", "query": "game.enemiesAlive", "op": "eq", "value": 3 },

    { "type": "log", "message": "testing frost_peak lever and checkpoint mechanics" },
    { "type": "assert", "query": "game.mech.gate_1.t", "op": "lt", "value": 0.05 },
    { "type": "cvar", "name": "astro.ride", "set": "lever_1" },
    { "type": "wait-frames", "n": 30 },
    { "type": "key", "code": "X", "action": "press" },
    { "type": "wait-until", "query": "game.mech.gate_1.t", "op": "ge", "value": 0.95, "timeoutMs": 4000 },
    { "type": "cvar", "name": "astro.ride", "set": "fountain" },
    { "type": "wait-until", "query": "game.playerY", "op": "gt", "value": 7.0, "timeoutMs": 6000 },
    { "type": "wait-frames", "n": 20 },
    { "type": "screenshot", "out": "screenshots/nextastrobot_frost", "ui": false },

    { "type": "log", "message": "the last level (frost_peak) result screen ends the run and starts it over" },
    { "type": "cvar", "name": "astro.state", "set": "result" },
    { "type": "wait-until", "query": "game.state", "op": "eq", "value": "result", "timeoutMs": 8000 },
    { "type": "screenshot", "out": "screenshots/nextastrobot_result_final", "ui": true },
    { "type": "key", "code": "SPACE", "action": "press" },
    { "type": "wait-until", "query": "game.levelId", "op": "eq", "value": "sky_garden", "timeoutMs": 20000 },
    { "type": "wait-until", "query": "game.state", "op": "eq", "value": "title", "timeoutMs": 20000 },
    { "type": "assert", "query": "game.level", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.campaignCoins", "op": "eq", "value": 0 },
    { "type": "assert", "query": "game.campaignDeaths", "op": "eq", "value": 0 },
    { "type": "quit" }
  ]
}
