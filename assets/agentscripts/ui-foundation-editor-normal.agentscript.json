{
  "name": "ui-foundation-editor-normal",
  "target": "gkNextEditor",
  "scene": "assets/models/playground.glb",
  "viewport": { "width": 1440, "height": 900 },
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 10000 },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running" },
    { "type": "cvar", "name": "r.rendererType", "set": 1 },
    { "type": "key", "code": "F2", "action": "press" },
    { "type": "key", "code": "GRAVE", "action": "press" },
    { "type": "wait-frames", "n": 8 },
    { "type": "assert", "query": "cvar.r.rendererType", "op": "eq", "value": 1 },
    { "type": "screenshot", "out": "screenshots/ui_foundation_editor_normal" },
    { "type": "quit" }
  ]
}
