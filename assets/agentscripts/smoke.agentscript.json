{
  "name": "smoke",
  "target": "gkNextRenderer",
  "scene": "assets/models/playground.glb",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 8000
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 8000 },
    { "type": "wait-frames", "n": 30 },
    { "type": "key", "code": "W", "action": "press" },
    { "type": "mouse-move", "to": { "norm": [0.5, 0.5] } },
    { "type": "assert", "query": "engine.totalFrames", "op": "ge", "value": 1 },
    { "type": "screenshot", "out": "screenshots/agent_script_smoke" },
    { "type": "quit" }
  ]
}
