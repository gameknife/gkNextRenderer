{
  "name": "native-taau-smoke",
  "target": "gkNextRenderer",
  "scene": "assets/models/playground.glb",
  "defaults": {
    "waitFrames": 0,
    "stepTimeoutMs": 10000
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 10000 },
    { "type": "cvar", "name": "r.dlss", "set": false },
    { "type": "cvar", "name": "r.fsr", "set": false },
    { "type": "cvar", "name": "r.superResolution", "set": 0 },
    { "type": "cvar", "name": "r.fsr.postFilter", "set": true },
    { "type": "cvar", "name": "r.taau", "set": true },
    { "type": "wait-frames", "n": 60 },
    { "type": "assert", "query": "cvar.r.taau", "op": "eq", "value": true },
    { "type": "assert", "query": "cvar.r.fsr.postFilter", "op": "eq", "value": true },
    { "type": "assert", "query": "engine.totalFrames", "op": "ge", "value": 30 },
    { "type": "screenshot", "out": "screenshots/native_taau_smoke" },
    { "type": "quit" }
  ]
}
