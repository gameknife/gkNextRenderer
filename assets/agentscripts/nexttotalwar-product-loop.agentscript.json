{
  "name": "nexttotalwar-product-loop",
  "target": "NextTotalwar",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 30000 },
  "viewport": { "width": 1600, "height": 900 },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 30000 },
    { "type": "wait-until", "query": "game.navReady", "op": "eq", "value": true, "timeoutMs": 120000 },
    { "type": "cvar", "name": "tw.validation.issuePlayerAttack", "set": true },
    { "type": "wait-until", "query": "game.playerAttackOrders", "op": "ge", "value": 1, "timeoutMs": 30000 },
    { "type": "assert", "query": "game.selectedEnemyRegiments", "op": "eq", "value": 0 },
    { "type": "wait-until", "query": "game.rangedVolleys", "op": "ge", "value": 1, "timeoutMs": 60000 },
    { "type": "assert", "query": "game.arrowPoolCapacity", "op": "eq", "value": 96 },
    { "type": "wait-until", "query": "game.activeArrows", "op": "ge", "value": 1, "timeoutMs": 30000 },
    { "type": "screenshot", "out": "screenshots/nexttotalwar_volley", "ui": true },
    { "type": "wait-until", "query": "game.totalKills", "op": "ge", "value": 1, "timeoutMs": 60000 },
    { "type": "cvar", "name": "tw.validation.moraleShock", "set": true },
    { "type": "wait-until", "query": "game.routingRegiments", "op": "ge", "value": 1, "timeoutMs": 30000 },
    { "type": "cvar", "name": "tw.validation.finishEnemy", "set": true },
    { "type": "wait-until", "query": "game.battlePhase", "op": "eq", "value": "Finished", "timeoutMs": 30000 },
    { "type": "assert", "query": "game.battleResult", "op": "eq", "value": "Victory" },
    { "type": "screenshot", "out": "screenshots/nexttotalwar_product_loop", "ui": true },
    { "type": "cvar", "name": "tw.validation.restart", "set": true },
    { "type": "wait-until", "query": "game.battlePhase", "op": "eq", "value": "Battle", "timeoutMs": 30000 },
    { "type": "assert", "query": "game.factionStrength0", "op": "eq", "value": 1200 },
    { "type": "assert", "query": "game.factionStrength1", "op": "eq", "value": 1200 },
    { "type": "assert", "query": "game.battleResult", "op": "eq", "value": "Undecided" },
    { "type": "quit" }
  ]
}
