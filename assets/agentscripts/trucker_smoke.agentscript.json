{
  "name": "trucker_smoke",
  "target": "TruckerDemo",
  "scene": "assets/scad/source/overhill/overhill_mission.scad",
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 8000 },
    { "type": "wait-frames", "n": 120 },
    { "type": "assert", "query": "engine.totalFrames", "op": "ge", "value": 1 },
    { "type": "assert", "query": "game.missionState", "op": "eq", "value": "available" },
    { "type": "assert", "query": "game.fuel", "op": "gt", "value": 0 },
    { "type": "key", "code": "F", "action": "press" },
    { "type": "wait-frames", "n": 5 },
    { "type": "assert", "query": "game.missionState", "op": "eq", "value": "drive-to-pickup" },
    { "type": "key", "code": "Q", "action": "press" },
    { "type": "key", "code": "E", "action": "press" },
    { "type": "assert", "query": "game.diffLock", "op": "eq", "value": true },
    { "type": "assert", "query": "game.awd", "op": "eq", "value": true },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-frames", "n": 180 },
    { "type": "assert", "query": "engine.totalFrames", "op": "ge", "value": 200 },
    { "type": "assert", "query": "game.gear", "op": "ge", "value": 1 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "assert", "query": "game.fuel", "op": "lt", "value": 90 },
    { "type": "cvar", "name": "trucker.validation.missionStage", "set": 1 },
    { "type": "wait-frames", "n": 20 },
    { "type": "assert", "query": "game.missionState", "op": "eq", "value": "at-pickup" },
    { "type": "key", "code": "F", "action": "press" },
    { "type": "wait-frames", "n": 5 },
    { "type": "assert", "query": "game.missionState", "op": "eq", "value": "loaded" },
    { "type": "cvar", "name": "trucker.validation.missionStage", "set": 2 },
    { "type": "wait-frames", "n": 20 },
    { "type": "assert", "query": "game.missionState", "op": "eq", "value": "at-dropoff" },
    { "type": "key", "code": "F", "action": "press" },
    { "type": "wait-frames", "n": 5 },
    { "type": "assert", "query": "game.missionState", "op": "eq", "value": "complete" },
    { "type": "screenshot", "out": "screenshots/trucker_smoke" },
    { "type": "quit" }
  ]
}
