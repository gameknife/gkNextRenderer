{
  "name": "trucker_smoke",
  "target": "TruckerDemo",
  "scene": "assets/scad/overhill_mission.scad",
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 8000 },
    { "type": "wait-frames", "n": 120 },
    { "type": "assert", "query": "engine.totalFrames", "op": "ge", "value": 1 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-frames", "n": 180 },
    { "type": "assert", "query": "engine.totalFrames", "op": "ge", "value": 200 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "screenshot", "out": "screenshots/trucker_smoke" },
    { "type": "quit" }
  ]
}
