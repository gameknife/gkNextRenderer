{
  "name": "swrestir-smoke",
  "target": "gkNextRenderer",
  "scene": "ManyLightsShowcase.proc",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 30000
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "cvar", "name": "r.rendererType", "set": 1 },
    { "type": "cvar", "name": "r.restir.enable", "set": false },
    { "type": "cvar", "name": "r.temporalFrames", "set": 1 },
    { "type": "wait-frames", "n": 40 },
    { "type": "assert", "query": "engine.rendererType", "op": "eq", "value": 1 },
    { "type": "screenshot", "out": "screenshots/swrestir_classic" },
    { "type": "cvar", "name": "r.restir.temporal", "set": false },
    { "type": "cvar", "name": "r.restir.spatial", "set": false },
    { "type": "cvar", "name": "r.restir.candidates", "set": 1 },
    { "type": "cvar", "name": "r.restir.enable", "set": true },
    { "type": "wait-frames", "n": 20 },
    { "type": "screenshot", "out": "screenshots/swrestir_ris1" },
    { "type": "cvar", "name": "r.restir.candidates", "set": 8 },
    { "type": "wait-frames", "n": 20 },
    { "type": "screenshot", "out": "screenshots/swrestir_ris8" },
    { "type": "cvar", "name": "r.restir.temporal", "set": true },
    { "type": "wait-frames", "n": 40 },
    { "type": "screenshot", "out": "screenshots/swrestir_temporal_only" },
    { "type": "cvar", "name": "r.restir.temporal", "set": false },
    { "type": "cvar", "name": "r.restir.spatial", "set": true },
    { "type": "wait-frames", "n": 20 },
    { "type": "screenshot", "out": "screenshots/swrestir_spatial_only" },
    { "type": "cvar", "name": "r.restir.temporal", "set": true },
    { "type": "wait-frames", "n": 40 },
    { "type": "screenshot", "out": "screenshots/swrestir_reuse" },
    { "type": "cvar", "name": "r.restir.debugMode", "set": 4 },
    { "type": "wait-frames", "n": 5 },
    { "type": "screenshot", "out": "screenshots/swrestir_debug_reuse" },
    { "type": "cvar", "name": "r.restir.debugMode", "set": 0 },
    { "type": "cvar", "name": "r.restir.enable", "set": false },
    { "type": "cvar", "name": "r.restir.candidates", "set": 8 },
    { "type": "cvar", "name": "r.temporalFrames", "set": 16 },
    { "type": "quit" }
  ]
}
