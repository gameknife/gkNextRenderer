{
  "name": "visibility-buffer-70k",
  "target": "gkNextRenderer",
  "scene": "MassiveAsteroidBelt.proc",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 120000
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 120000 },
    { "type": "wait-until", "query": "scene.renderProxyCount", "op": "eq", "value": 70000, "timeoutMs": 120000 },
    { "type": "wait-frames", "n": 60 },
    { "type": "assert", "query": "scene.nodeCount", "op": "eq", "value": 70002 },
    { "type": "assert", "query": "scene.renderProxyCount", "op": "eq", "value": 70000 },
    { "type": "wait-until", "query": "scene.maxVisibleProxyIndex", "op": "ge", "value": 65536, "timeoutMs": 30000 },
    { "type": "screenshot", "out": "screenshots/visibility_buffer_70k" },
    { "type": "quit" }
  ]
}
