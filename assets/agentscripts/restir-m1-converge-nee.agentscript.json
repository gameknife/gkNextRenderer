{
  "name": "restir-m1-converge-nee",
  "target": "gkNextRenderer",
  "scene": "CornellBox.proc",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 120000
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "cvar", "name": "r.restir.enable", "set": false },
    { "type": "cvar", "name": "r.temporalFrames", "set": 1024 },
    { "type": "wait-frames", "n": 20 },
    { "type": "log", "message": "Bias reference: classic NEE accumulated 600 frames, static camera" },
    { "type": "wait-frames", "n": 600 },
    { "type": "screenshot", "out": "screenshots/restir_m1_converged_nee" },
    { "type": "cvar", "name": "r.temporalFrames", "set": 16 },
    { "type": "wait-frames", "n": 5 },
    { "type": "quit" }
  ]
}
