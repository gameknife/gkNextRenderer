{
  "name": "surface-legacy-parity",
  "target": "gkNextRenderer",
  "scene": "assets/models/playground.glb",
  "defaults": {
    "waitFrames": 0,
    "stepTimeoutMs": 30000
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 30000 },
    { "type": "cvar", "name": "sys.tickPhysics", "set": false },
    { "type": "cvar", "name": "sys.tickAnimation", "set": false },
    { "type": "cvar", "name": "r.upscaler.type", "set": 0 },
    { "type": "cvar", "name": "r.checkerboardRendering", "set": false },
    { "type": "cvar", "name": "r.restir.enable", "set": false },
    { "type": "cvar", "name": "r.samples", "set": 64 },

    { "type": "cvar", "name": "r.rendererType", "set": 4 },
    { "type": "cvar", "name": "r.gtao.enable", "set": false },
    { "type": "wait-frames", "n": 40 },
    { "type": "screenshot", "out": "screenshots/legacy_parity_noambient" },

    { "type": "cvar", "name": "r.rendererType", "set": 2 },
    { "type": "wait-frames", "n": 40 },
    { "type": "screenshot", "out": "screenshots/legacy_parity_swmodern", "accumulateFrames": 192, "timeoutMs": 90000 },

    { "type": "cvar", "name": "r.rendererType", "set": 1 },
    { "type": "wait-frames", "n": 40 },
    { "type": "screenshot", "out": "screenshots/legacy_parity_swtracing", "accumulateFrames": 192, "timeoutMs": 90000 },

    { "type": "cvar", "name": "r.rendererType", "set": 0 },
    { "type": "wait-frames", "n": 40 },
    { "type": "screenshot", "out": "screenshots/legacy_parity_pathtracing", "accumulateFrames": 192, "timeoutMs": 90000 },

    { "type": "quit" }
  ]
}
