{
  "name": "nextastrobot-mechanisms",
  "target": "NextAstrobot",
  "scene": "assets/scad/source/astro/sky_garden.scad",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 20000 },
  "viewport": { "width": 1600, "height": 900 },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "wait-frames", "n": 30 },
    { "type": "cvar", "name": "astro.state", "set": "playing" },
    { "type": "wait-frames", "n": 40 },
    { "type": "cvar", "name": "astro.god", "set": true },

    { "type": "log", "message": "conveyor: standing still on the belt still moves you (surface velocity)" },
    { "type": "cvar", "name": "astro.ride", "set": "conveyor" },
    { "type": "wait-frames", "n": 40 },
    { "type": "assert", "query": "game.onGround", "op": "eq", "value": true },
    { "type": "assert", "query": "game.playerX", "op": "gt", "value": 38.5 },
    { "type": "wait-ms", "ms": 2000 },
    { "type": "assert", "query": "game.playerX", "op": "lt", "value": 37.0 },
    { "type": "screenshot", "out": "screenshots/nextastrobot_conveyor", "ui": true },

    { "type": "log", "message": "spin disc: the rider is carried around by the disc's tangential speed" },
    { "type": "cvar", "name": "astro.ride", "set": "spin" },
    { "type": "wait-frames", "n": 40 },
    { "type": "assert", "query": "game.onGround", "op": "eq", "value": true },
    { "type": "assert", "query": "game.playerZ", "op": "gt", "value": -8.8 },
    { "type": "assert", "query": "game.playerZ", "op": "lt", "value": -7.2 },
    { "type": "wait-ms", "ms": 2500 },
    { "type": "assert", "query": "game.playerZ", "op": "lt", "value": -8.7 },

    { "type": "log", "message": "moving platform: the rail car carries a passenger with it" },
    { "type": "wait-until", "query": "game.mech.moving.t", "op": "gt", "value": 0.85, "timeoutMs": 20000 },
    { "type": "cvar", "name": "astro.ride", "set": "moving" },
    { "type": "wait-frames", "n": 40 },
    { "type": "assert", "query": "game.onGround", "op": "eq", "value": true },
    { "type": "assert", "query": "game.playerX", "op": "gt", "value": 28.5 },
    { "type": "wait-ms", "ms": 5000 },
    { "type": "assert", "query": "game.playerX", "op": "lt", "value": 26.0 },
    { "type": "screenshot", "out": "screenshots/nextastrobot_moving", "ui": true },

    { "type": "log", "message": "pendulum and seesaw are driven, not parked at their bind pose" },
    { "type": "assert", "query": "game.mech.pendulum.t", "op": "gt", "value": 0.0 },
    { "type": "cvar", "name": "astro.ride", "set": "seesaw" },
    { "type": "wait-frames", "n": 60 },
    { "type": "assert", "query": "game.onGround", "op": "eq", "value": true },
    { "type": "wait-ms", "ms": 1200 },
    { "type": "assert", "query": "game.mech.seesaw.t", "op": "ne", "value": 0.5 },

    { "type": "log", "message": "bounce pad: stepping on to it throws the player metres into the air" },
    { "type": "cvar", "name": "astro.ride", "set": "bounce" },
    { "type": "wait-frames", "n": 30 },
    { "type": "wait-ms", "ms": 400 },
    { "type": "assert", "query": "game.playerY", "op": "gt", "value": 3.5 },
    { "type": "assert", "query": "game.onGround", "op": "eq", "value": false },

    { "type": "log", "message": "button latches the gate with the same idx open" },
    { "type": "assert", "query": "game.mech.gate_1.t", "op": "lt", "value": 0.1 },
    { "type": "cvar", "name": "astro.ride", "set": "button_1" },
    { "type": "wait-frames", "n": 40 },
    { "type": "assert", "query": "game.mech.button_1.t", "op": "eq", "value": 1.0 },
    { "type": "wait-until", "query": "game.mech.gate_1.t", "op": "ge", "value": 0.99, "timeoutMs": 4000 },
    { "type": "screenshot", "out": "screenshots/nextastrobot_gate", "ui": true },

    { "type": "log", "message": "crumbling slab: it holds for warn seconds, then drops the player in the pool" },
    { "type": "cvar", "name": "astro.god", "set": false },
    { "type": "assert", "query": "game.deaths", "op": "eq", "value": 0 },
    { "type": "cvar", "name": "astro.ride", "set": "crumble" },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "game.onGround", "op": "eq", "value": true },
    { "type": "assert", "query": "game.mech.crumble.t", "op": "lt", "value": 0.9 },
    { "type": "wait-until", "query": "game.mech.crumble.t", "op": "ge", "value": 0.99, "timeoutMs": 6000 },
    { "type": "wait-until", "query": "game.deaths", "op": "eq", "value": 1, "timeoutMs": 8000 },
    { "type": "quit" }
  ]
}
