{
  "name": "nextastrobot-combat",
  "target": "NextAstrobot",
  "scene": "assets/scad/source/astro/sky_garden.scad",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 20000 },
  "viewport": { "width": 1600, "height": 900 },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "wait-frames", "n": 30 },
    { "type": "cvar", "name": "astro.state", "set": "playing" },
    { "type": "wait-frames", "n": 40 },
    { "type": "assert", "query": "game.punchStage", "op": "eq", "value": 0 },

    { "type": "log", "message": "combo: three presses chain left jab -> right cross -> spin kick" },
    { "type": "key", "code": "X", "action": "press" },
    { "type": "wait-until", "query": "game.punchStage", "op": "eq", "value": 1, "timeoutMs": 2000 },
    { "type": "assert", "query": "game.locomotion", "op": "eq", "value": "punch" },
    { "type": "assert", "query": "game.clip", "op": "eq", "value": "punch" },
    { "type": "key", "code": "X", "action": "press" },
    { "type": "wait-until", "query": "game.punchStage", "op": "eq", "value": 2, "timeoutMs": 2000 },
    { "type": "assert", "query": "game.clip", "op": "eq", "value": "punch2" },
    { "type": "key", "code": "X", "action": "press" },
    { "type": "wait-until", "query": "game.punchStage", "op": "eq", "value": 3, "timeoutMs": 2000 },
    { "type": "assert", "query": "game.clip", "op": "eq", "value": "kick" },
    { "type": "wait-ms", "ms": 240 },
    { "type": "screenshot", "out": "screenshots/nextastrobot_kick", "ui": false },

    { "type": "log", "message": "the chain drops back to nothing once the window lapses" },
    { "type": "wait-until", "query": "game.punchStage", "op": "eq", "value": 0, "timeoutMs": 4000 },
    { "type": "assert", "query": "game.punching", "op": "eq", "value": false },

    { "type": "log", "message": "a fourth press after the window starts the chain over at the jab" },
    { "type": "key", "code": "X", "action": "press" },
    { "type": "wait-until", "query": "game.punchStage", "op": "eq", "value": 1, "timeoutMs": 2000 },
    { "type": "wait-until", "query": "game.punchStage", "op": "eq", "value": 0, "timeoutMs": 4000 },

    { "type": "log", "message": "skid: reversing at full run brakes through a slide before turning" },
    { "type": "cvar", "name": "astro.teleport", "set": "-60,0.25,1" },
    { "type": "wait-frames", "n": 40 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 900 },
    { "type": "assert", "query": "game.locomotion", "op": "eq", "value": "run" },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "key", "code": "S", "action": "down" },
    { "type": "wait-until", "query": "game.locomotion", "op": "eq", "value": "skid", "timeoutMs": 1000 },
    { "type": "assert", "query": "game.clip", "op": "eq", "value": "skid" },
    { "type": "wait-ms", "ms": 130 },
    { "type": "screenshot", "out": "screenshots/nextastrobot_skid", "ui": false },
    { "type": "wait-until", "query": "game.locomotion", "op": "eq", "value": "run", "timeoutMs": 3000 },
    { "type": "key", "code": "S", "action": "up" },
    { "type": "wait-until", "query": "game.locomotion", "op": "eq", "value": "idle", "timeoutMs": 3000 },

    { "type": "log", "message": "rescue: freeing a robot holds a close-up while it walks out and cheers" },
    { "type": "assert", "query": "game.camFocus", "op": "eq", "value": 0.0 },
    { "type": "cvar", "name": "astro.teleport", "set": "-46,0.3,8" },
    { "type": "wait-until", "query": "game.rescued", "op": "eq", "value": 1, "timeoutMs": 4000 },
    { "type": "assert", "query": "game.rescueRigs", "op": "eq", "value": 1 },
    { "type": "wait-until", "query": "game.camFocus", "op": "gt", "value": 0.9, "timeoutMs": 2000 },
    { "type": "screenshot", "out": "screenshots/nextastrobot_rescue", "ui": false },
    { "type": "log", "message": "it turns back to face the player and cheers once, then waves" },
    { "type": "wait-ms", "ms": 900 },
    { "type": "screenshot", "out": "screenshots/nextastrobot_rescue_cheer", "ui": false },
    { "type": "log", "message": "and hands the shot back to the chase camera on its own" },
    { "type": "wait-until", "query": "game.camFocus", "op": "eq", "value": 0.0, "timeoutMs": 6000 },

    { "type": "log", "message": "the run cycle itself: the upper body leads the legs" },
    { "type": "cvar", "name": "astro.teleport", "set": "-60,0.25,1" },
    { "type": "wait-frames", "n": 40 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 700 },
    { "type": "assert", "query": "game.locomotion", "op": "eq", "value": "run" },
    { "type": "screenshot", "out": "screenshots/nextastrobot_run", "ui": false },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "wait-until", "query": "game.locomotion", "op": "eq", "value": "idle", "timeoutMs": 3000 },

    { "type": "log", "message": "the jump pitch: push off leaning in, then whip back over the tuck" },
    { "type": "key", "code": "SPACE", "action": "press" },
    { "type": "wait-ms", "ms": 120 },
    { "type": "assert", "query": "game.clip", "op": "eq", "value": "jump" },
    { "type": "screenshot", "out": "screenshots/nextastrobot_jump", "ui": false },
    { "type": "wait-until", "query": "game.onGround", "op": "eq", "value": true, "timeoutMs": 6000 },
    { "type": "quit" }
  ]
}
