{
  "name": "restir-m0-debug",
  "target": "gkNextRenderer",
  "scene": "CornellBox.proc",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 10000
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "cvar", "name": "r.rendererType", "set": 0 },
    { "type": "wait-frames", "n": 5 },
    { "type": "wait-frames", "n": 20 },
    { "type": "log", "message": "ReSTIR M0: debugMode 1 expects a 16px red/green checkerboard (M heatmap) after a few frames" },
    { "type": "cvar", "name": "r.restir.enable", "set": true },
    { "type": "cvar", "name": "r.restir.debugMode", "set": 1 },
    { "type": "wait-frames", "n": 30 },
    { "type": "screenshot", "out": "screenshots/restir_m0_debug_m" },
    { "type": "cvar", "name": "r.restir.debugMode", "set": 2 },
    { "type": "wait-frames", "n": 35 },
    { "type": "screenshot", "out": "screenshots/restir_m0_debug_w" },
    { "type": "cvar", "name": "r.restir.debugMode", "set": 0 },
    { "type": "cvar", "name": "r.restir.enable", "set": false },
    { "type": "wait-frames", "n": 15 },
    { "type": "screenshot", "out": "screenshots/restir_m0_off" },
    { "type": "log", "message": "PathTracingLite intentionally does not support ReSTIR; this script validates ReSTIR on the SHARC PathTracing renderer only" },
    { "type": "wait-frames", "n": 15 },
    { "type": "screenshot", "out": "screenshots/restir_m0_restored" },
    { "type": "assert", "query": "engine.totalFrames", "op": "ge", "value": 100 },
    { "type": "quit" }
  ]
}
