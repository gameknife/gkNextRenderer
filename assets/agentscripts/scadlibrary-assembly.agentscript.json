{
  "name": "scadlibrary-assembly",
  "target": "ScadLibrary",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 30000
  },
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "steps": [
    {
      "type": "wait-until",
      "query": "engine.status",
      "op": "eq",
      "value": "Running",
      "timeoutMs": 20000
    },
    {
      "type": "wait-frames",
      "n": 90
    },
    {
      "type": "assert",
      "query": "scene.nodeCount",
      "op": "ge",
      "value": 5
    },
    {
      "type": "screenshot",
      "out": "screenshots/scadlibrary_assembly",
      "ui": true
    },
    {
      "type": "quit"
    }
  ]
}
