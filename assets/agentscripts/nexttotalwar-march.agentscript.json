{
  "name": "nexttotalwar-march",
  "target": "NextTotalwar",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 30000
  },
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "steps": [
    {"type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 30000},
    {"type": "wait-until", "query": "game.navReady", "op": "eq", "value": true, "timeoutMs": 120000},
    {"type": "wait-until", "query": "game.soldierCount", "op": "eq", "value": 3072, "timeoutMs": 120000},
    {"type": "assert", "query": "game.massiveMode", "op": "eq", "value": true},
    {"type": "assert", "query": "game.renderProxyCount", "op": "ge", "value": 16384},
    {"type": "wait-frames", "n": 20},
    {"type": "drag", "from": {"norm": [0.10, 0.20]}, "to": {"norm": [0.49, 0.72]}, "button": "left"},
    {"type": "assert", "query": "game.selectedRegiments", "op": "ge", "value": 1},
    {"type": "drag", "from": {"norm": [0.64, 0.47]}, "to": {"norm": [0.72, 0.47]}, "button": "right"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.lastOrderDistance", "op": "ge", "value": 20},
    {"type": "wait-until", "query": "game.marchingRegiments", "op": "eq", "value": 0, "timeoutMs": 90000},
    {"type": "screenshot", "out": "screenshots/nexttotalwar-march", "ui": true},
    {"type": "quit"}
  ]
}
