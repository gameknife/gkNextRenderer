    {
      "type": "cvar",
      "name": "r.surface.build",
      "set": true
    },
    {
      "type": "wait-frames",
      "n": 90
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.shadingpass",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.checkerboard resolve",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.surface build",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.frameRate",
      "op": "ge",
      "value": 0
    },
    {
      "type": "screenshot",
      "out": "screenshots/surface_m3_swmodern_full_surface"
    },
    {
      "type": "log",
      "message": "=== swmodern | cb | legacy ==="
    },
