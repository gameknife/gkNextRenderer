{
  "name": "surface-tracing-ab",
  "target": "gkNextRenderer",
  "scene": "assets/models/playground.glb",
  "defaults": {
    "waitFrames": 0,
    "stepTimeoutMs": 30000
  },
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "steps": [
    {
      "type": "wait-until",
      "query": "engine.status",
      "op": "eq",
      "value": "Running",
      "timeoutMs": 30000
    },
    {
      "type": "cvar",
      "name": "sys.tickPhysics",
      "set": false
    },
    {
      "type": "cvar",
      "name": "sys.tickAnimation",
      "set": false
    },
    {
      "type": "log",
      "message": "=== swmodern | full | legacy ==="
    },
    {
      "type": "cvar",
      "name": "r.rendererType",
      "set": 2
    },
    {
      "type": "cvar",
      "name": "r.restir.enable",
      "set": false
    },
    {
      "type": "cvar",
      "name": "r.upscaler.type",
      "set": 0
    },
    {
      "type": "cvar",
      "name": "r.upscaler.qualityMode",
      "set": 4
    },
    {
      "type": "cvar",
      "name": "r.checkerboardRendering",
      "set": false
    },
    {
      "type": "cvar",
      "name": "r.surface.build",
      "set": false
    },
    {
      "type": "wait-frames",
      "n": 90
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.shadingpass",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.checkerboard resolve",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.gpuTime.surface build",
      "op": "ge",
      "value": 0
    },
    {
      "type": "assert",
      "query": "engine.frameRate",
      "op": "ge",
      "value": 0
    },
    {
      "type": "screenshot",
      "out": "screenshots/surface_m3_swmodern_full_legacy"
    },
    {
      "type": "log",
      "message": "=== swmodern | full | surface ==="
    },
    {
      "type": "cvar",
      "name": "r.rendererType",
      "set": 2
    },
    {
      "type": "cvar",
      "name": "r.restir.enable",
      "set": false
    },
    {
      "type": "cvar",
      "name": "r.upscaler.type",
