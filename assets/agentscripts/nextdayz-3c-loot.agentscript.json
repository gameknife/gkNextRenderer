{
  "name": "nextdayz-3c-loot",
  "target": "NextDayz",
  "scene": "assets/scad/proc/coldwar/riverland_1km.scad",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 20000 },
  "viewport": { "width": 1600, "height": 900 },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "wait-frames", "n": 60 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 650 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "mouse-move", "relative": true, "to": { "px": [0, 0] } },
    { "type": "mouse-move", "relative": true, "to": { "px": [0, 150] } },
    { "type": "wait-frames", "n": 8 },

    { "type": "log", "message": "3C: reservation starts action without committing inventory" },
    { "type": "assert", "query": "game.lootRemaining", "op": "eq", "value": 59 },
    { "type": "assert", "query": "game.inventoryCount", "op": "eq", "value": 2 },
    { "type": "key", "code": "E", "action": "press" },
    { "type": "wait-ms", "ms": 180 },
    { "type": "assert", "query": "game.action", "op": "eq", "value": "loot_ground" },
    { "type": "assert", "query": "game.actionTime", "op": "gt", "value": 0.1 },
    { "type": "assert", "query": "game.actionTime", "op": "lt", "value": 0.55 },
    { "type": "assert", "query": "game.lootRemaining", "op": "eq", "value": 59 },
    { "type": "assert", "query": "game.inventoryCount", "op": "eq", "value": 2 },

    { "type": "log", "message": "3C: movement before commit cancels and releases reservation" },
    { "type": "key", "code": "A", "action": "press" },
    { "type": "wait-frames", "n": 10 },
    { "type": "assert", "query": "game.action", "op": "eq", "value": "none" },
    { "type": "assert", "query": "game.lootRemaining", "op": "eq", "value": 59 },
    { "type": "assert", "query": "game.inventoryCount", "op": "eq", "value": 2 },

    { "type": "log", "message": "3C: second attempt locks aim, fire, sprint and commits at 55 percent" },
    { "type": "key", "code": "V", "action": "press" },
    { "type": "key", "code": "E", "action": "press" },
    { "type": "wait-ms", "ms": 180 },
    { "type": "mouse-button", "button": "right", "action": "down" },
    { "type": "mouse-button", "button": "left", "action": "down" },
    { "type": "key", "code": "LSHIFT", "action": "down" },
    { "type": "wait-frames", "n": 3 },
    { "type": "assert", "query": "game.action", "op": "eq", "value": "loot_ground" },
    { "type": "assert", "query": "game.isAiming", "op": "eq", "value": false },
    { "type": "assert", "query": "game.gait", "op": "eq", "value": "idle" },
    { "type": "assert", "query": "game.shotSequence", "op": "eq", "value": 0 },
    { "type": "screenshot", "out": "screenshots/nextdayz_3c_loot_precommit" },
    { "type": "wait-ms", "ms": 350 },
    { "type": "assert", "query": "game.action", "op": "eq", "value": "loot_ground" },
    { "type": "assert", "query": "game.actionTime", "op": "gt", "value": 0.55 },
    { "type": "assert", "query": "game.lootRemaining", "op": "eq", "value": 58 },
    { "type": "assert", "query": "game.inventoryCount", "op": "gt", "value": 2 },
    { "type": "screenshot", "out": "screenshots/nextdayz_3c_loot_postcommit" },
    { "type": "mouse-button", "button": "right", "action": "up" },
    { "type": "mouse-button", "button": "left", "action": "up" },
    { "type": "key", "code": "LSHIFT", "action": "up" },
    { "type": "wait-ms", "ms": 450 },
    { "type": "assert", "query": "game.action", "op": "eq", "value": "none" },
    { "type": "assert", "query": "game.shotSequence", "op": "eq", "value": 0 },

    { "type": "quit" }
  ]
}
