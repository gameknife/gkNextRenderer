{
  "name": "editor-play-in-editor",
  "target": "gkNextEditor",
  "scene": "assets/models/playground.glb",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "defaults": {
    "waitFrames": 3,
    "stepTimeoutMs": 60000
  },
  "comment": "Play-in-editor: run a C# game inside the editor, inspect its scene through the editor's own panels, then stop and get the edited scene back. ed.play is the control channel (a game id to start, empty to stop); ed.playEject hands input and the camera back to the editor without stopping the game.",
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running" },
    { "type": "wait-frames", "n": 20 },
    { "type": "assert", "query": "game.pieAvailable", "op": "eq", "value": true },
    { "type": "assert", "query": "game.pieGameCount", "op": "ge", "value": 3 },
    { "type": "assert", "query": "game.pieState", "op": "eq", "value": "Stopped" },
    { "type": "assert", "query": "game.scenePath", "op": "eq", "value": "assets/models/playground.glb" },
    { "type": "screenshot", "ui": true, "out": "screenshots/editor_pie_before" },

    { "type": "log", "message": "play brotato3d inside the editor" },
    { "type": "cvar", "name": "ed.play", "set": "brotato3d" },
    { "type": "wait-until", "query": "game.pieState", "op": "eq", "value": "Playing" },
    { "type": "wait-until", "query": "scene.nodeCount", "op": "ge", "value": 1000,
      "comment": "The game's own SCAD arena committed — the editor is showing the game's world, not the playground." },
    { "type": "wait-frames", "n": 60 },
    { "type": "assert", "query": "game.pieActive", "op": "eq", "value": "brotato3d" },
    { "type": "screenshot", "ui": true, "out": "screenshots/editor_pie_playing" },

    { "type": "log", "message": "eject: the game keeps running, the editor takes back input and camera" },
    { "type": "cvar", "name": "ed.playEject", "set": true },
    { "type": "wait-frames", "n": 10 },
    { "type": "assert", "query": "game.pieState", "op": "eq", "value": "Ejected" },
    { "type": "assert", "query": "game.pieActive", "op": "eq", "value": "brotato3d",
      "comment": "Still loaded: ejecting is not stopping." },
    { "type": "assert", "query": "scene.nodeCount", "op": "ge", "value": 1000 },
    { "type": "wait-frames", "n": 30 },
    { "type": "screenshot", "ui": true, "out": "screenshots/editor_pie_ejected",
      "comment": "The outliner is populated from the running game's scene." },

    { "type": "log", "message": "select one of the running game's nodes through the outliner" },
    { "type": "mouse-move", "to": { "norm": [0.099, 0.251] },
      "comment": "Third row of the outliner. Move and press are separate steps: ImGui hit-tests against the position it saw last frame." },
    { "type": "wait-frames", "n": 5 },
    { "type": "mouse-button", "button": "left", "action": "down" },
    { "type": "wait-frames", "n": 5 },
    { "type": "mouse-button", "button": "left", "action": "up" },
    { "type": "wait-frames", "n": 10 },
    { "type": "assert", "query": "scene.selectedCount", "op": "ge", "value": 1,
      "comment": "A node of the live game scene is selected, which is what fills the properties panel." },
    { "type": "screenshot", "ui": true, "out": "screenshots/editor_pie_ejected_selected",
      "comment": "Properties now shows the selected node's components — inspectable and editable while the game runs." },

    { "type": "log", "message": "resume, then stop" },
    { "type": "cvar", "name": "ed.playEject", "set": false },
    { "type": "wait-frames", "n": 10 },
    { "type": "assert", "query": "game.pieState", "op": "eq", "value": "Playing" },

    { "type": "cvar", "name": "ed.play", "set": "" },
    { "type": "wait-until", "query": "game.pieState", "op": "eq", "value": "Stopped" },
    { "type": "wait-until", "query": "scene.nodeCount", "op": "le", "value": 999,
      "comment": "The game's world is gone." },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "game.pieActive", "op": "eq", "value": "" },
    { "type": "assert", "query": "scene.nodeCount", "op": "ge", "value": 10,
      "comment": "...and the scene that was open before Play was reloaded in its place." },
    { "type": "wait-frames", "n": 120 },
    { "type": "assert", "query": "game.pieState", "op": "eq", "value": "Stopped",
      "comment": "Stopped has to stay stopped. The world baseline restores every cvar a game could have touched, and if the editor's own ed.play were among them the restore would write the last game's id back and start it again — a stop that only holds for one frame." },
    { "type": "assert", "query": "game.pieActive", "op": "eq", "value": "" },
    { "type": "screenshot", "ui": true, "out": "screenshots/editor_pie_after" },

    { "type": "log", "message": "a second play/stop cycle must behave identically" },
    { "type": "cvar", "name": "ed.play", "set": "flappy" },
    { "type": "wait-until", "query": "game.pieState", "op": "eq", "value": "Playing" },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "game.pieActive", "op": "eq", "value": "flappy" },
    { "type": "cvar", "name": "ed.play", "set": "" },
    { "type": "wait-until", "query": "game.pieState", "op": "eq", "value": "Stopped" },
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running",
      "comment": "Wait, do not assert: stopping queues a reload of the scene that was open before Play, and the engine sits in Loading while it parses." },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "scene.nodeCount", "op": "ge", "value": 10 },
    { "type": "quit" }
  ]
}
