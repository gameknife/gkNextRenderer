{
  "name": "nextdayz-3c-locomotion",
  "target": "NextDayz",
  "scene": "assets/scad/coldwar/riverland_1km.scad",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 20000 },
  "viewport": { "width": 1600, "height": 900 },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "wait-frames", "n": 60 },
    { "type": "key", "code": "V", "action": "press" },
    { "type": "wait-frames", "n": 20 },

    { "type": "log", "message": "3C: standing idle and run are the defaults" },
    { "type": "assert", "query": "game.stance", "op": "eq", "value": "standing" },
    { "type": "assert", "query": "game.gait", "op": "eq", "value": "idle" },
    { "type": "assert", "query": "game.baseAnim", "op": "eq", "value": "stand_idle" },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-frames", "n": 15 },
    { "type": "assert", "query": "game.gait", "op": "eq", "value": "run" },
    { "type": "assert", "query": "game.baseAnim", "op": "eq", "value": "stand_run_f" },
    { "type": "key", "code": "W", "action": "up" },

    { "type": "log", "message": "3C: Ctrl walk and Shift sprint select distinct gait clips" },
    { "type": "key", "code": "LCTRL", "action": "down" },
    { "type": "key", "code": "D", "action": "down" },
    { "type": "wait-frames", "n": 15 },
    { "type": "assert", "query": "game.gait", "op": "eq", "value": "walk" },
    { "type": "assert", "query": "game.baseAnim", "op": "eq", "value": "stand_walk_r" },
    { "type": "key", "code": "D", "action": "up" },
    { "type": "key", "code": "LCTRL", "action": "up" },
    { "type": "key", "code": "LSHIFT", "action": "down" },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-frames", "n": 15 },
    { "type": "assert", "query": "game.gait", "op": "eq", "value": "sprint" },
    { "type": "assert", "query": "game.baseAnim", "op": "eq", "value": "stand_sprint_f" },
    { "type": "screenshot", "out": "screenshots/nextdayz_3c_sprint" },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "key", "code": "LSHIFT", "action": "up" },

    { "type": "log", "message": "3C: crouch changes capsule and supports four-direction blending" },
    { "type": "key", "code": "C", "action": "press" },
    { "type": "wait-frames", "n": 20 },
    { "type": "assert", "query": "game.stance", "op": "eq", "value": "crouched" },
    { "type": "assert", "query": "game.controllerHeight", "op": "lt", "value": 1.3 },
    { "type": "assert", "query": "game.baseAnim", "op": "eq", "value": "crouch_idle" },
    { "type": "key", "code": "S", "action": "down" },
    { "type": "key", "code": "A", "action": "down" },
    { "type": "wait-frames", "n": 20 },
    { "type": "assert", "query": "game.gait", "op": "eq", "value": "walk" },
    { "type": "assert", "query": "game.localMoveX", "op": "lt", "value": -0.5 },
    { "type": "assert", "query": "game.localMoveY", "op": "lt", "value": -0.5 },
    { "type": "screenshot", "out": "screenshots/nextdayz_3c_crouch_diagonal" },
    { "type": "key", "code": "S", "action": "up" },
    { "type": "key", "code": "A", "action": "up" },
    { "type": "key", "code": "C", "action": "press" },
    { "type": "wait-frames", "n": 20 },
    { "type": "assert", "query": "game.stance", "op": "eq", "value": "standing" },
    { "type": "assert", "query": "game.controllerHeight", "op": "gt", "value": 1.7 },

    { "type": "quit" }
  ]
}
