{
  "name": "checkerboard-rendering-smoke",
  "target": "gkNextRenderer",
  "scene": "assets/models/playground.glb",
  "defaults": {
    "waitFrames": 0,
    "stepTimeoutMs": 15000
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 10000 },
    { "type": "cvar", "name": "r.rendererType", "set": 2 },
    { "type": "cvar", "name": "r.upscaler.type", "set": 4 },
    { "type": "cvar", "name": "r.upscaler.qualityMode", "set": 4 },
    { "type": "cvar", "name": "r.checkerboardRendering", "set": true },
    { "type": "wait-frames", "n": 60 },
    { "type": "assert", "query": "cvar.r.checkerboardRendering", "op": "eq", "value": true },
    { "type": "screenshot", "out": "screenshots/checkerboard_rendering_on" },
    { "type": "cvar", "name": "r.checkerboardRendering", "set": false },
    { "type": "cvar", "name": "r.upscaler.type", "set": 0 },
    { "type": "wait-frames", "n": 2 },
    { "type": "cvar", "name": "r.upscaler.type", "set": 4 },
    { "type": "wait-frames", "n": 60 },
    { "type": "assert", "query": "cvar.r.checkerboardRendering", "op": "eq", "value": false },
    { "type": "screenshot", "out": "screenshots/checkerboard_rendering_off" },
    { "type": "quit" }
  ]
}
