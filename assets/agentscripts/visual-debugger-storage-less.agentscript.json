{
  "name": "visual-debugger-storage-less",
  "target": "gkNextRenderer",
  "scene": "assets/models/playground.glb",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 8000
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 8000 },
    { "type": "cvar", "name": "show.visualDebug", "set": true },
    { "type": "wait-frames", "n": 12 },
    { "type": "screenshot", "out": "screenshots/agent_visual_debug" },
    { "type": "quit" }
  ]
}
