{
  "name": "restir-m1-quick",
  "target": "gkNextRenderer",
  "scene": "ManyLightsShowcase.proc",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 20000
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "wait-frames", "n": 30 },
    { "type": "log", "message": "Raw single-frame noise: classic NEE vs ReSTIR RIS-only at equal spp (temporalFrames=1)" },
    { "type": "cvar", "name": "r.restir.enable", "set": false },
    { "type": "cvar", "name": "r.temporalFrames", "set": 1 },
    { "type": "wait-frames", "n": 15 },
    { "type": "screenshot", "out": "screenshots/restir_m1_nee_raw" },
    { "type": "cvar", "name": "r.restir.enable", "set": true },
    { "type": "wait-frames", "n": 15 },
    { "type": "screenshot", "out": "screenshots/restir_m1_restir_raw" },
    { "type": "cvar", "name": "r.restir.debugMode", "set": 1 },
    { "type": "wait-frames", "n": 5 },
    { "type": "screenshot", "out": "screenshots/restir_m1_debug_m" },
    { "type": "cvar", "name": "r.restir.debugMode", "set": 3 },
    { "type": "wait-frames", "n": 5 },
    { "type": "screenshot", "out": "screenshots/restir_m1_debug_light" },
    { "type": "cvar", "name": "r.restir.debugMode", "set": 0 },
    { "type": "cvar", "name": "r.restir.enable", "set": false },
    { "type": "cvar", "name": "r.temporalFrames", "set": 16 },
    { "type": "wait-frames", "n": 5 },
    { "type": "quit" }
  ]
}
