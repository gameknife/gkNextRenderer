{
  "name": "restir-m1-perf",
  "target": "gkNextRenderer",
  "scene": "ManyLightsShowcase.proc",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 30000
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "steps": [
    {
      "type": "wait-until",
      "query": "engine.status",
      "op": "eq",
      "value": "Running",
      "timeoutMs": 20000
    },
    {
      "type": "cvar",
      "name": "r.restir.enable",
      "set": false
    },
    {
      "type": "wait-frames",
      "n": 120
    },
    {
      "type": "assert",
      "query": "engine.frameRate",
      "op": "ge",
      "value": 1
    },
    {
      "type": "cvar",
      "name": "r.restir.enable",
      "set": true
    },
    {
      "type": "wait-frames",
      "n": 120
    },
    {
      "type": "assert",
      "query": "engine.frameRate",
      "op": "ge",
      "value": 1
    },
    {
      "type": "cvar",
      "name": "r.restir.enable",
      "set": false
    },
    {
      "type": "quit"
    }
  ]
}