// ============================================================================
// astro_bot.scad - NextAstrobot 主角机器人 rig（ScadRig，刚体骨骼、无蒙皮）
//
// 约定（AGENT_GUIDE/ScadRig.md）：
//   * 1 unit = 1 m，Z-up；根骨骼原点 = 两脚间地面投影（z=0），身高 1.6 m
//   * bone_ 前缀 module = 骨骼；调用点外层 translate/rotate = 绑定 pivot
//   * 顶层 anim_<name> 变量 = 动画 clip（时间秒，rot 为度，OpenSCAD rotate 语义）
//   * ROLECOLOR 纯品红 = 运行时换色占位（腰带 / 手 / 脚 / 眼灯），默认染成 ab_BLUE()
//   * 面朝 -Y（引擎空间 +Z）
//
// 外观与关卡里的 NPC 机器人 ab_char_bot 一致：白色高光机身 + 蓝色目镜/耳灯/手足，
// 所以配色函数与材质包装都从 kit_astro 取。
// 在原版 OpenSCAD / ScadStudio 中直接打开即显示绑定姿态。
// ============================================================================

use <../lib/kit_astro.scad>

$fn = 12;

ROLECOLOR = [1, 0, 1];          // 换色占位：腰带 / 手球 / 脚 / 眼灯

// ---- 部件 helper（非骨骼，几何折叠进所属骨骼） ----

// 腿：髋 pivot 在原点，白色小腿垂下 + 悬浮脚
module part_leg()
{
    ab_gloss(ab_WHITE()) translate([0, 0, -0.16]) cylinder(h = 0.26, r = 0.07, center = true);
    ab_gloss(ROLECOLOR)  translate([0, -0.03, -0.35]) ab_ellipsoid(0.12, 0.17, 0.10);
}

// 手臂：肩 pivot 在原点，白臂垂下 + 蓝手球
module part_arm()
{
    ab_gloss(ab_WHITE()) translate([0, 0, -0.20]) cylinder(h = 0.40, r = 0.06, center = true);
    ab_gloss(ROLECOLOR)  translate([0, 0, -0.44]) sphere(r = 0.09);
}

// ---- 骨骼层级 ----

module bone_head()
{
    ab_gloss(ab_WHITE()) sphere(r = 0.36);
    ab_gloss(ab_VISOR()) translate([0, -0.18, 0]) ab_ellipsoid(0.30, 0.22, 0.25);
    for (sx = [-1, 1])
    {
        ab_gloss(ROLECOLOR)  translate([sx * 0.11, -0.385, 0.03]) ab_ellipsoid(0.05, 0.03, 0.10);
        ab_gloss(ab_BLUE())  translate([sx * 0.37, 0, 0]) rotate([0, 90, 0]) cylinder(h = 0.10, r = 0.12, center = true);
    }
}

module bone_arm_l() { part_arm(); }
module bone_arm_r() { mirror([1, 0, 0]) part_arm(); }   // mirror 在骨骼体内：烘进网格

// 悬浮喷焰：每只脚一道，默认由游戏隐藏，悬浮时显形。
// 参考 PS5《宇宙机器人》：不是一个短胖的锥，而是**两道又细又长的光束**——静止悬浮时约
// 1.4 个身高（2.2 m），起跳那一下还会被 hover clip 的 scale 通道拉到 3.5 m。
// 调用点带 rotate([180,0,0])，所以骨骼局部 +Z 朝下，scale 的 z 分量就是焰长。
module ab_jet_beam()
{
    ab_gloss(ab_BLUEL()) cylinder(h = 2.20, r1 = 0.055, r2 = 0.010);   // 细长光束
    ab_gloss(ab_WHITE()) cylinder(h = 0.34, r1 = 0.075, r2 = 0.018);   // 根部亮核
}

module bone_jet_l() { ab_jet_beam(); }
module bone_jet_r() { ab_jet_beam(); }

// 喷焰挂在脚下（mirror 只作用于紧跟的 part_leg，喷焰骨骼不受影响）
module bone_leg_l() { part_leg(); translate([0, -0.03, -0.44]) rotate([180, 0, 0]) bone_jet_l(); }
module bone_leg_r() { mirror([1, 0, 0]) part_leg(); translate([0, -0.03, -0.44]) rotate([180, 0, 0]) bone_jet_r(); }

module bone_torso()
{
    ab_gloss(ab_WHITE()) translate([0, 0, 0.25]) ab_ellipsoid(0.28, 0.24, 0.34);
    ab_gloss(ROLECOLOR)  translate([0, 0, 0.01]) ab_ellipsoid(0.245, 0.21, 0.08);
    ab_gloss(ab_BLUEL()) translate([0, -0.22, 0.33]) ab_ellipsoid(0.10, 0.05, 0.10);   // 胸灯
    ab_gloss(ab_BLUE())  translate([0, 0.24, 0.27]) ab_ellipsoid(0.16, 0.09, 0.20);    // 背包

    translate([0, 0, 0.77])  bone_head();
    translate([-0.30, 0, 0.47]) bone_arm_l();
    translate([ 0.30, 0, 0.47]) bone_arm_r();
}

module bone_root()          // 原点落地
{
    translate([0, 0, 0.45]) bone_torso();
    translate([-0.15, 0, 0.45]) bone_leg_l();
    translate([ 0.15, 0, 0.45]) bone_leg_r();
}

bone_root();

// ---- 动画 clips ----
// 必需 clip（Test_AstroBotRig 硬性检查）：idle / run / skid / jump / fall / hover / land /
// punch / punch2 / kick / hurt / win / zip / wave / cheer。
// 非循环：jump / land / skid / punch / punch2 / kick / hurt / cheer。
//
// 通道选择（这个 rig 最容易踩的坑）：
//   手臂与腿的几何是绕自身局部 Z 轴对称的圆柱 + 球，所以 "rot" 的 Z 分量转了也看不见。
//   摆动（前后）用 X：负 = 向前，正 = 向后。
//   外张 / 上举用 Y：左肢正 = 向外，右肢负 = 向外（右侧几何是骨骼体内 mirror，骨骼坐标系没镜像）。
//   躯干 / 头 / 根骨骼不是轴对称的，X = 俯仰、Y = 侧倾、Z = 扭身，三个通道都有效。

// 待机：2 s 呼吸 + 手臂微摆 + 头部左右张望
anim_idle = [
    ["bone_torso", "pos", [for (t = [0 : 0.5 : 2]) [t, [0, 0, 0.015 * sin(180 * t)]]]],
    ["bone_arm_l", "rot", [for (t = [0 : 0.5 : 2]) [t, [4 * sin(180 * t), 9, 0]]]],
    ["bone_arm_r", "rot", [for (t = [0 : 0.5 : 2]) [t, [-4 * sin(180 * t), -9, 0]]]],
    ["bone_head",  "rot", [for (t = [0 : 0.5 : 2]) [t, [0, 0, 5 * sin(90 * t)]]]],
];

// 跑：0.34 s 周期（约 6 步/秒）。
// 参考 PS5《宇宙机器人》的跑法，三个特征缺一不可：
//   1. **小碎步高步频**：视频里脚每 0.167 s 交错一次，所以循环 0.34 s；腿只摆 ±26 度，
//      始终收在身体下面，摆大步反而不像。
//   2. **上身后仰**：根骨骼 -6 度 + 躯干 -12 度，头顶落在脚跟后面。这是这个角色最好认的
//      剪影——大头往后坐，不是田径式的前倾。
//   3. **手臂摊开**：Y（外张）才是主角度，基础 50~75 度，两条手臂交替一高一低地扇；
//      X（前后摆）只留 ±16 度点缀。写成前后大摆就变成普通人形跑步了。
anim_run = [
    ["bone_leg_l", "rot", [[0, [26, 4, 0]], [0.17, [-26, 4, 0]], [0.34, [26, 4, 0]]]],
    ["bone_leg_r", "rot", [[0, [-26, -4, 0]], [0.17, [26, -4, 0]], [0.34, [-26, -4, 0]]]],
    ["bone_arm_l", "rot", [[0, [-16, 74, 0]], [0.17, [16, 52, 0]], [0.34, [-16, 74, 0]]]],
    ["bone_arm_r", "rot", [[0, [16, -52, 0]], [0.17, [-16, -74, 0]], [0.34, [16, -52, 0]]]],
    ["bone_torso", "rot", [[0, [-12, 0, 5]], [0.085, [-14, 0, 0]], [0.17, [-12, 0, -5]],
                           [0.255, [-14, 0, 0]], [0.34, [-12, 0, 5]]]],
    ["bone_head",  "rot", [[0, [5, 0, 0]], [0.17, [8, 0, 0]], [0.34, [5, 0, 0]]]],
    ["bone_root",  "rot", [[0, [-6, 4, 0]], [0.17, [-6, -4, 0]], [0.34, [-6, 4, 0]]]],
    ["bone_root",  "pos", [[0, [0, 0, 0]], [0.085, [0, 0, 0.035]], [0.17, [0, 0, 0]],
                           [0.255, [0, 0, 0.035]], [0.34, [0, 0, 0]]]],
];

// 急停变向：0.34 s 非循环。全速下反向输入时播放，配合控制器的刹车段。
// 读法：上身从跑步的后仰再往后压一截、前脚蹬出去撑住、双臂张开找平衡、重心压低。
// t=0 的姿势刻意抄 run 的第一帧，这样 0.06 s 的淡入不会跳一下。
anim_skid = [
    ["loop", false],
    ["bone_root",  "rot", [[0, [-6, 0, 0]], [0.1, [-26, 12, 0]], [0.22, [-20, 8, 0]], [0.34, [0, 0, 0]]]],
    ["bone_root",  "pos", [[0, [0, 0, 0]], [0.1, [0, 0.06, -0.12]], [0.22, [0, 0.04, -0.10]],
                           [0.34, [0, 0, 0]]]],
    ["bone_torso", "rot", [[0, [-12, 0, 0]], [0.1, [-30, 0, 14]], [0.22, [-24, 0, 10]], [0.34, [0, 0, 0]]]],
    ["bone_head",  "rot", [[0, [5, 0, 0]], [0.1, [20, 0, -18]], [0.34, [0, 0, 0]]]],
    ["bone_leg_l", "rot", [[0, [26, 4, 0]], [0.1, [-46, 8, 0]], [0.22, [-38, 8, 0]], [0.34, [0, 0, 0]]]],
    ["bone_leg_r", "rot", [[0, [-26, -4, 0]], [0.1, [30, -6, 0]], [0.22, [22, -6, 0]], [0.34, [0, 0, 0]]]],
    ["bone_arm_l", "rot", [[0, [-16, 74, 0]], [0.1, [-26, 88, 0]], [0.22, [-18, 80, 0]], [0.34, [0, 0, 0]]]],
    ["bone_arm_r", "rot", [[0, [16, -52, 0]], [0.1, [10, -92, 0]], [0.22, [4, -84, 0]], [0.34, [0, 0, 0]]]],
];

