// ============================================================================
// astro_bot.scad - NextAstrobot 主角机器人 rig（ScadRig，刚体骨骼、无蒙皮）
//
// 约定（AGENT_GUIDE/ScadRig.md）：
//   * 1 unit = 1 m，Z-up；根骨骼原点 = 两脚间地面投影（z=0），身高 1.6 m
//   * bone_ 前缀 module = 骨骼；调用点外层 translate/rotate = 绑定 pivot
//   * 顶层 anim_<name> 变量 = 动画 clip（时间秒，rot 为度，OpenSCAD rotate 语义）
//   * ROLECOLOR 纯品红 = 运行时换色占位（腰带 / 手 / 脚 / 眼灯），默认染成 ab_BLUE()
//   * 面朝 -Y（引擎空间 +Z）
//
// 外观与关卡里的 NPC 机器人 ab_char_bot 一致：白色高光机身 + 蓝色目镜/耳灯/手足，
// 所以配色函数与材质包装都从 kit_astro 取。
// 在原版 OpenSCAD / ScadStudio 中直接打开即显示绑定姿态。
// ============================================================================

use <../lib/kit_astro.scad>

$fn = 12;

ROLECOLOR = [1, 0, 1];          // 换色占位：腰带 / 手球 / 脚 / 眼灯

// ---- 部件 helper（非骨骼，几何折叠进所属骨骼） ----

// 腿：髋 pivot 在原点，白色小腿垂下 + 悬浮脚
module part_leg()
{
    ab_gloss(ab_WHITE()) translate([0, 0, -0.16]) cylinder(h = 0.26, r = 0.07, center = true);
    ab_gloss(ROLECOLOR)  translate([0, -0.03, -0.35]) ab_ellipsoid(0.12, 0.17, 0.10);
}

// 手臂：肩 pivot 在原点，白臂垂下 + 蓝手球
module part_arm()
{
    ab_gloss(ab_WHITE()) translate([0, 0, -0.20]) cylinder(h = 0.40, r = 0.06, center = true);
    ab_gloss(ROLECOLOR)  translate([0, 0, -0.44]) sphere(r = 0.09);
}

// ---- 骨骼层级 ----

module bone_head()
{
    ab_gloss(ab_WHITE()) sphere(r = 0.36);
    ab_gloss(ab_VISOR()) translate([0, -0.18, 0]) ab_ellipsoid(0.30, 0.22, 0.25);
    for (sx = [-1, 1])
    {
        ab_gloss(ROLECOLOR)  translate([sx * 0.11, -0.385, 0.03]) ab_ellipsoid(0.05, 0.03, 0.10);
        ab_gloss(ab_BLUE())  translate([sx * 0.37, 0, 0]) rotate([0, 90, 0]) cylinder(h = 0.10, r = 0.12, center = true);
    }
}

module bone_arm_l() { part_arm(); }
module bone_arm_r() { mirror([1, 0, 0]) part_arm(); }   // mirror 在骨骼体内：烘进网格

module bone_leg_l() { part_leg(); }
module bone_leg_r() { mirror([1, 0, 0]) part_leg(); }

// 悬浮喷焰：默认由游戏隐藏，悬浮时显形
module bone_jet()
{
    ab_gloss(ab_BLUEL()) cylinder(h = 0.55, r1 = 0.16, r2 = 0.02);
    ab_gloss(ab_CREAM()) cylinder(h = 0.18, r1 = 0.10, r2 = 0.02);
}

module bone_torso()
{
    ab_gloss(ab_WHITE()) translate([0, 0, 0.25]) ab_ellipsoid(0.28, 0.24, 0.34);
    ab_gloss(ROLECOLOR)  translate([0, 0, 0.01]) ab_ellipsoid(0.245, 0.21, 0.08);
    ab_gloss(ab_BLUEL()) translate([0, -0.22, 0.33]) ab_ellipsoid(0.10, 0.05, 0.10);   // 胸灯
    ab_gloss(ab_BLUE())  translate([0, 0.24, 0.27]) ab_ellipsoid(0.16, 0.09, 0.20);    // 背包

    translate([0, 0, 0.77])  bone_head();
    translate([-0.30, 0, 0.47]) bone_arm_l();
    translate([ 0.30, 0, 0.47]) bone_arm_r();
    translate([0, 0, -0.03]) rotate([180, 0, 0]) bone_jet();
}

module bone_root()          // 原点落地
{
    translate([0, 0, 0.45]) bone_torso();
    translate([-0.15, 0, 0.45]) bone_leg_l();
    translate([ 0.15, 0, 0.45]) bone_leg_r();
}

bone_root();

// ---- 动画 clips ----
// 必需 clip（Test_AstroBotRig 硬性检查）：idle / run / jump / fall / hover / land /
// punch / hurt / win / zip / wave。jump/land/punch/hurt 非循环。

// 待机：2 s 呼吸 + 手臂微摆
anim_idle = [
    ["bone_torso", "pos", [for (t = [0 : 0.5 : 2]) [t, [0, 0, 0.015 * sin(180 * t)]]]],
    ["bone_arm_l", "rot", [for (t = [0 : 0.5 : 2]) [t, [4 * sin(180 * t), 0,  6]]]],
    ["bone_arm_r", "rot", [for (t = [0 : 0.5 : 2]) [t, [-4 * sin(180 * t), 0, -6]]]],
    ["bone_head",  "rot", [for (t = [0 : 0.5 : 2]) [t, [0, 0, 5 * sin(90 * t)]]]],
];

// 跑：0.5 s 周期对应 6 m/s（腿 ±45°、臂反相 ±38°、root 上下 bob）
anim_run = [
    ["bone_leg_l", "rot", [[0, [ 45, 0, 0]], [0.25, [-45, 0, 0]], [0.5, [ 45, 0, 0]]]],
    ["bone_leg_r", "rot", [[0, [-45, 0, 0]], [0.25, [ 45, 0, 0]], [0.5, [-45, 0, 0]]]],
    ["bone_arm_l", "rot", [[0, [-38, 0, 0]], [0.25, [ 38, 0, 0]], [0.5, [-38, 0, 0]]]],
    ["bone_arm_r", "rot", [[0, [ 38, 0, 0]], [0.25, [-38, 0, 0]], [0.5, [ 38, 0, 0]]]],
    ["bone_torso", "rot", [[0, [8, 0, 0]], [0.5, [8, 0, 0]]]],
    ["bone_root",  "pos", [[0, [0, 0, 0]], [0.125, [0, 0, 0.05]], [0.25, [0, 0, 0]],
                           [0.375, [0, 0, 0.05]], [0.5, [0, 0, 0]]]],
];

// 起跳：0.35 s 非循环，收腿 + 抬臂
anim_jump = [
    ["loop", false],
    ["bone_leg_l", "rot", [[0, [10, 0, 0]], [0.12, [-55, 0, 0]], [0.35, [-35, 0, 0]]]],
    ["bone_leg_r", "rot", [[0, [10, 0, 0]], [0.12, [-50, 0, 0]], [0.35, [-30, 0, 0]]]],
    ["bone_arm_l", "rot", [[0, [0, 0, 0]], [0.12, [-140, 0, 12]], [0.35, [-120, 0, 12]]]],
    ["bone_arm_r", "rot", [[0, [0, 0, 0]], [0.12, [-140, 0, -12]], [0.35, [-120, 0, -12]]]],
    ["bone_torso", "rot", [[0, [0, 0, 0]], [0.35, [-6, 0, 0]]]],
];

// 下落：0.8 s 循环，腿分开、双臂外展
anim_fall = [
    ["bone_leg_l", "rot", [[0, [-18, 0, 0]], [0.4, [-26, 0, 0]], [0.8, [-18, 0, 0]]]],
    ["bone_leg_r", "rot", [[0, [ 14, 0, 0]], [0.4, [ 22, 0, 0]], [0.8, [ 14, 0, 0]]]],
    ["bone_arm_l", "rot", [[0, [-70, 0, 34]], [0.4, [-80, 0, 40]], [0.8, [-70, 0, 34]]]],
    ["bone_arm_r", "rot", [[0, [-70, 0, -34]], [0.4, [-80, 0, -40]], [0.8, [-70, 0, -34]]]],
];

// 悬浮：1 s 循环，腿并拢、双臂外展 80°、躯干轻微上下
anim_hover = [
    ["bone_leg_l", "rot", [[0, [0, 0, 6]], [0.5, [0, 0, 6]], [1.0, [0, 0, 6]]]],
    ["bone_leg_r", "rot", [[0, [0, 0, -6]], [0.5, [0, 0, -6]], [1.0, [0, 0, -6]]]],
    ["bone_arm_l", "rot", [[0, [0, 0, 80]], [0.5, [0, 0, 86]], [1.0, [0, 0, 80]]]],
    ["bone_arm_r", "rot", [[0, [0, 0, -80]], [0.5, [0, 0, -86]], [1.0, [0, 0, -80]]]],
    ["bone_root",  "pos", [[0, [0, 0, 0]], [0.5, [0, 0, 0.04]], [1.0, [0, 0, 0]]]],
];

// 落地：0.3 s 非循环，屈膝缓冲
anim_land = [
    ["loop", false],
    ["bone_root",  "pos", [[0, [0, 0, -0.14]], [0.14, [0, 0, -0.06]], [0.3, [0, 0, 0]]]],
    ["bone_leg_l", "rot", [[0, [40, 0, 0]], [0.3, [0, 0, 0]]]],
    ["bone_leg_r", "rot", [[0, [40, 0, 0]], [0.3, [0, 0, 0]]]],
    ["bone_arm_l", "rot", [[0, [-40, 0, 24]], [0.3, [0, 0, 0]]]],
    ["bone_arm_r", "rot", [[0, [-40, 0, -24]], [0.3, [0, 0, 0]]]],
];

// 拳击：0.35 s 非循环，右臂前伸 + 躯干拧转
anim_punch = [
    ["loop", false],
    ["bone_arm_r", "rot", [[0, [30, 0, 0]], [0.12, [-95, 0, 0]], [0.24, [-95, 0, 0]], [0.35, [0, 0, 0]]]],
    ["bone_arm_l", "rot", [[0, [-20, 0, 0]], [0.12, [30, 0, 0]], [0.35, [0, 0, 0]]]],
    ["bone_torso", "rot", [[0, [0, 0, 0]], [0.12, [0, 0, -22]], [0.35, [0, 0, 0]]]],
];

// 受伤：0.4 s 非循环，后仰 + 双臂张开
anim_hurt = [
    ["loop", false],
    ["bone_torso", "rot", [[0, [0, 0, 0]], [0.12, [-26, 0, 0]], [0.4, [-14, 0, 0]]]],
    ["bone_head",  "rot", [[0, [0, 0, 0]], [0.12, [-20, 0, 0]], [0.4, [-12, 0, 0]]]],
    ["bone_arm_l", "rot", [[0, [0, 0, 0]], [0.12, [-30, 0, 50]], [0.4, [-20, 0, 40]]]],
    ["bone_arm_r", "rot", [[0, [0, 0, 0]], [0.12, [-30, 0, -50]], [0.4, [-20, 0, -40]]]],
];

// 胜利：1.6 s 循环欢呼
anim_win = [
    ["bone_arm_l", "rot", [[0, [0, 0, 150]], [0.4, [0, 0, 165]], [0.8, [0, 0, 150]],
                           [1.2, [0, 0, 165]], [1.6, [0, 0, 150]]]],
    ["bone_arm_r", "rot", [[0, [0, 0, -150]], [0.4, [0, 0, -165]], [0.8, [0, 0, -150]],
                           [1.2, [0, 0, -165]], [1.6, [0, 0, -150]]]],
    ["bone_root",  "pos", [[0, [0, 0, 0]], [0.4, [0, 0, 0.12]], [0.8, [0, 0, 0]],
                           [1.2, [0, 0, 0.12]], [1.6, [0, 0, 0]]]],
];

// 滑索：0.9 s 循环，双臂上举抓握、腿后摆
anim_zip = [
    ["bone_arm_l", "rot", [[0, [0, 0, 158]], [0.45, [0, 0, 162]], [0.9, [0, 0, 158]]]],
    ["bone_arm_r", "rot", [[0, [0, 0, -158]], [0.45, [0, 0, -162]], [0.9, [0, 0, -158]]]],
    ["bone_leg_l", "rot", [[0, [24, 0, 0]], [0.45, [32, 0, 0]], [0.9, [24, 0, 0]]]],
    ["bone_leg_r", "rot", [[0, [20, 0, 0]], [0.45, [28, 0, 0]], [0.9, [20, 0, 0]]]],
    ["bone_torso", "rot", [[0, [-8, 0, 0]], [0.9, [-8, 0, 0]]]],
];

// 挥手：1.2 s 循环（被救机器人 / 待机彩蛋）
anim_wave = [
    ["bone_arm_r", "rot", [[0, [0, 0, -150]], [0.3, [0, 0, -175]], [0.6, [0, 0, -150]],
                           [0.9, [0, 0, -175]], [1.2, [0, 0, -150]]]],
    ["bone_head",  "rot", [[0, [0, 0, 0]], [0.6, [0, 0, -8]], [1.2, [0, 0, 0]]]],
];
