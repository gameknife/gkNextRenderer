// 关键是**俯仰要摆一下**：蹬地那一帧上身前倾 16 度压住，收腿的同时甩成后仰 20 度，
// 最后停在后仰 12 度接 fall。原来全程只后仰 6~10 度，看上去起跳和站着是同一个姿势。
anim_jump = [
    ["loop", false],
    ["bone_torso", "rot", [[0, [16, 0, 0]], [0.10, [-20, 0, 0]], [0.22, [-16, 0, 0]], [0.35, [-12, 0, 0]]]],
    ["bone_head",  "rot", [[0, [-10, 0, 0]], [0.10, [14, 0, 0]], [0.35, [10, 0, 0]]]],
    ["bone_root",  "rot", [[0, [6, 0, 0]], [0.10, [-8, 0, 0]], [0.35, [-5, 0, 0]]]],
    ["bone_leg_l", "rot", [[0, [16, 0, 0]], [0.12, [-62, 10, 0]], [0.35, [-40, 8, 0]]]],
    ["bone_leg_r", "rot", [[0, [16, 0, 0]], [0.12, [-56, -10, 0]], [0.35, [-34, -8, 0]]]],
