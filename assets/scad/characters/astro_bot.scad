                           [0.75, [-0.035, 0, 0.10]], [1.0, [0, 0, 0]]]],
    // 焰长脉动：SCAD z = 焰长，基础 2.2 m，所以在 1.8~3.5 m 之间抖。两只脚错开半拍，
    // 免得两道光束像一根被镜像的贴片。
    ["bone_jet_l", "scale", [[0, [1, 1, 0.85]], [0.12, [1.15, 1.15, 1.58]], [0.25, [1, 1, 1.02]],
                             [0.37, [1.12, 1.12, 1.46]], [0.5, [1, 1, 0.85]], [0.62, [1.15, 1.15, 1.58]],
