// 下落：0.8 s 循环。和 hover 的区别是刻意"没控制住"：手臂往后上方甩、腿乱蹬、身体前倾。
anim_fall = [
    ["bone_leg_l", "rot", [[0, [-26, 10, 0]], [0.4, [-6, 10, 0]], [0.8, [-26, 10, 0]]]],
    ["bone_leg_r", "rot", [[0, [-4, -10, 0]], [0.4, [-28, -10, 0]], [0.8, [-4, -10, 0]]]],
    ["bone_arm_l", "rot", [[0, [-104, 46, 0]], [0.4, [-118, 56, 0]], [0.8, [-104, 46, 0]]]],
    ["bone_arm_r", "rot", [[0, [-104, -46, 0]], [0.4, [-118, -56, 0]], [0.8, [-104, -46, 0]]]],
    ["bone_torso", "rot", [[0, [10, 0, 0]], [0.4, [14, 0, 0]], [0.8, [10, 0, 0]]]],
    ["bone_head",  "rot", [[0, [-12, 0, 0]], [0.4, [-8, 0, 0]], [0.8, [-12, 0, 0]]]],
];

// 悬浮：1 s 循环。要一眼看出来"这不是在下落，是在喷气悬停"：
// 双臂平举外张（Y 通道）、上身后仰、明显的上下起伏与左右飘移，外加脚下两道长喷焰。
// **腿必须基本垂直**：喷焰骨骼挂在脚下，腿收起来光束就会朝两边斜出去；参考视频里也是
// 腿垂着、光束笔直向下。所以这里只留很小的前后错位当摆荡。
anim_hover = [
    ["bone_arm_l", "rot", [[0, [-14, 76, 0]], [0.25, [-24, 88, 0]], [0.5, [-14, 76, 0]],
                           [0.75, [-24, 88, 0]], [1.0, [-14, 76, 0]]]],
    ["bone_arm_r", "rot", [[0, [-14, -76, 0]], [0.25, [-24, -88, 0]], [0.5, [-14, -76, 0]],
                           [0.75, [-24, -88, 0]], [1.0, [-14, -76, 0]]]],
    ["bone_leg_l", "rot", [[0, [-9, 5, 0]], [0.5, [-3, 5, 0]], [1.0, [-9, 5, 0]]]],
    ["bone_leg_r", "rot", [[0, [-3, -5, 0]], [0.5, [-9, -5, 0]], [1.0, [-3, -5, 0]]]],
    ["bone_torso", "rot", [[0, [-16, 5, 0]], [0.5, [-11, -5, 0]], [1.0, [-16, 5, 0]]]],
    ["bone_head",  "rot", [[0, [-10, 0, 7]], [0.5, [-10, 0, -7]], [1.0, [-10, 0, 7]]]],
    ["bone_root",  "rot", [[0, [0, 4, 0]], [0.5, [0, -4, 0]], [1.0, [0, 4, 0]]]],
