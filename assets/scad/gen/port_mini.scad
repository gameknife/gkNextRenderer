$fn = 12;

use <../lib/kit_layout.scad>
use <../lib/kit_city_blocks.scad>
use <../lib/kit_city_hd.scad>

// 地面
color([0.45, 0.62, 0.38]) translate([0, 0, -0.2]) cube([220, 170, 0.4], center = true);

// 街区类型分发（索引见 layout 常量注释）
module port_mini_block(t, seed)
{
    if (t == 0) { v2_block_apartments(seed = $seed); }
    if (t == 1) { v2_block_civic(seed = $seed); }
    if (t == 2) { v2_block_park(seed = $seed); }
    if (t == 3) { v2_block_houses(seed = $seed); }
    if (t == 4) { lay_pick(seed) { v2_block_shops(seed = $seed); v2_block_market(seed = $seed); } }
}

// 0=apt 1=civic 2=park 3=res 4=shop
PORT_MINI_L1 = [
    [3, 4, 0],
    [2, 1, 3],
];
lay_grid(3, 2, 56, 50, seed = 5)
        port_mini_block(PORT_MINI_L1[$row][$col], $seed);

lay_scatter(12, -104, 104, -80, -66, seed = 21)
    lay_pick($seed) { hc_nature_tree(); hc_nature_pine(); }
lay_scatter(12, -104, 104, 66, 80, seed = 22)
    lay_pick($seed) { hc_nature_tree(); hc_nature_pine(); }
lay_along([[-100, 60], [100, 60]], step = 20, seed = 4)
    hc_prop_lamp();
lay_along([[-100, -60], [100, -60]], step = 20, seed = 6)
    hc_prop_lamp();
