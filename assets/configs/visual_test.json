{
  "version": 2,
  "outputDir": "screenshots/visual_test",
  "defaultFramesToWait": 60,
  "loadTimeoutSeconds": 20.0,
  "baselineDir": "assets/visual_test_baselines",
  "diffThreshold": 5,
  "useSceneList": false,
  "includeExtensions": [
    ".proc",
    ".glb",
    ".gltf",
    ".ldr",
    ".mpd",
    ".scad",
    ".sog"
  ],
  "excludeScenes": [],
  "excludeSceneContains": [],
  "scenes": [
    "MaterialShowcase.proc",
    "LightingShowcase.proc",
    "CameraShowcase.proc",
    {
      "path": "AnimationShowcase.proc",
      "frames": 120
    },
    {
      "path": "PhysicsShowcase.proc",
      "frames": 180
    },
    {
      "path": "assets/scad/source/old_city.scad",
      "frames": 90
    },
    {
      "path": "assets/scad/source/beer_cup.scad",
      "frames": 90
    }
  ],
  "sceneTimeouts": {
    "PhysicsShowcase.proc": 30.0,
    "assets/scad/source/old_city.scad": 60.0,
    "assets/scad/source/beer_cup.scad": 30.0
  },
  "notes": {
    "PhysicsShowcase.proc": "Physics motion can have small platform-dependent variance; visual baseline is informational.",
    "assets/scad/source/old_city.scad": "SCAD loader uses Manifold for CSG on desktop; mobile/no-backend builds may still fall back to approximations."
  }
}
