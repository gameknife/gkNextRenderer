{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 26,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "environment": {
                "VCPKG_ROOT": "${sourceDir}/.vcpkg",
                "VCPKG_BINARY_SOURCES": "clear;files,${sourceDir}/.vcpkg_bincache,readwrite"
            },
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_MANIFEST_MODE": "ON",
                "VCPKG_INSTALL_OPTIONS": "--no-print-usage",
                "ENABLE_UNITY_BUILD": "ON"
            }
        },
        {
            "name": "windows",
            "inherits": "base",
            "displayName": "Windows (Ninja)",
            "generator": "Ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ENABLE_STREAMLINE": "ON"
            }
        },
        {
            "name": "windows-vcproj",
            "inherits": "base",
            "displayName": "Windows (VCProj)",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ENABLE_STREAMLINE": "ON"
            }
        },
        {
            "name": "windows-no-unity",
            "inherits": "windows",
            "displayName": "Windows (No Unity)",
            "cacheVariables": {
                "ENABLE_UNITY_BUILD": "OFF"
            }
        },
        {
            "name": "linux",
            "inherits": "base",
            "displayName": "Linux",
            "generator": "Ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "linux-arm64",
            "inherits": "base",
            "displayName": "Linux ARM64",
            "generator": "Ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "arm64-linux",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "macos-arm64",
            "inherits": "base",
            "displayName": "macOS ARM64",
            "generator": "Ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_OSX_SYSROOT": "macosx",
                "VCPKG_TARGET_TRIPLET": "arm64-osx",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "ios-device",
            "inherits": "base",
            "displayName": "iOS Device (arm64)",
            "generator": "Xcode",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_OSX_SYSROOT": "iphoneos",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets",
                "VCPKG_TARGET_TRIPLET": "arm64-ios"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows",
            "configurePreset": "windows",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "windows-no-unity",
            "configurePreset": "windows-no-unity",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "linux",
            "configurePreset": "linux",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "linux-arm64",
            "configurePreset": "linux-arm64",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "macos-arm64",
            "configurePreset": "macos-arm64",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "ios-device",
            "configurePreset": "ios-device",
            "configuration": "RelWithDebInfo"
        }
    ]
}
