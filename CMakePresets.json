{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_MODE": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "WITH_OIDN": "OFF",
        "WITH_AVIF": "OFF",
        "WITH_SUPERLUMINAL": "OFF",
        "WITH_STREAMLINE": "ON"
      }
    },
    {
      "name": "windows-dev",
      "inherits": "windows-base",
      "displayName": "Windows Dev (RelWithDebInfo)",
      "description": "Default Windows configuration for development",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-release",
      "inherits": "linux-base",
      "displayName": "Linux Release"
    },
    {
      "name": "android-linux-debug",
      "inherits": "base",
      "displayName": "Android on Linux Debug",
      "description": "Debug configuration for Android builds on Linux host",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "android-linux-release",
      "inherits": "base",
      "displayName": "Android on Linux Release",
      "description": "Release configuration for Android builds on Linux host",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "macos-arm64",
      "inherits": "macos-base",
      "displayName": "macOS ARM64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "macos-x64",
      "inherits": "macos-base",
      "displayName": "macOS x64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-osx"
      }
    },
    {
      "name": "ios-release",
      "inherits": "base",
      "displayName": "iOS Release",
      "description": "Release configuration for iOS builds on macOS host",
      "generator": "Xcode",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-ios",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "iOS",
        "GK_IOS_SKIP_CODE_SIGN": "ON",
        "MOLTENVK_ROOT": "${sourceDir}/external/MoltenVK/ios"
      }
    },
    {
      "name": "mingw",
      "inherits": "base",
      "generator": "Ninja",
      "displayName": "MinGW Release",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-dev",
      "configurePreset": "windows-dev",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "configuration": "Release"
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "macos-x64",
      "configurePreset": "macos-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "mingw",
      "configurePreset": "mingw",
      "configuration": "Release"
    },
    {
      "name": "ios-release",
      "configurePreset": "ios-release",
      "configuration": "Release"
    }
  ]
}
